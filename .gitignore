# Build output
/target/

# Local environment and secrets (never commit)
.env
.env.*
!.env.example
/infra/docker/runner.token

# Tooling state that is not part of the project
/.agents/solomon/state/
.DS_Store
*.swp

# Isolated worktrees created by agents
/.claude/worktrees/

# SDK build output and toolchain state
/sdks/*/node_modules/
/sdks/*/dist/
/sdks/python/.venv/
/sdks/python/**/__pycache__/
/sdks/python/*.egg-info/
/sdks/go/bin/
/sdks/dotnet/**/bin/
/sdks/dotnet/**/obj/
/sdks/java/**/target/
/sdks/**/.conformance/

# Isolated .NET runner build output
/runners/dotnet/**/bin/
/runners/dotnet/**/obj/

# Personal agent preferences and settings (never committed)
CLAUDE.local.md
AGENTS.local.md
.claude/settings.local.json
# Private database/OpenBao development fixture
/.local/
