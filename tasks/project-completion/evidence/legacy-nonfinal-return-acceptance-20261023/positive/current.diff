+  output-view) fixture_case=output-view ;;
+  nonfinal-return) fixture_case=nonfinal-return ;;
+  nonfinal-return-red) fixture_case=nonfinal-return-red ;;
+  *) echo "unknown SAGAT_Q5_CASE" >&2; exit 2 ;;
