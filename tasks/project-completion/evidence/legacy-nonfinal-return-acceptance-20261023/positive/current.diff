+const NONFINAL_CLOSED_SOURCE_SQL: &str = CLOSED_COLLECTION_SOURCE_SQL;
+fn nonfinal_sha(value: &Value) -> String {
+    Sha256::digest(serde_json::to_vec(value).expect("canonical private witness"))
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
