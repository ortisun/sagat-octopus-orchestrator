from pathlib import Path
import os,re,json,subprocess
root=Path('/tmp/sagat-completion-20261023/credential-order-v3');root.mkdir(mode=0o700,exist_ok=True)
source=Path('scripts/test-legacy-collection-output-view.sh').read_text()
names=['sha256','cleanup_new_databases','cache_private_receipt','remove_private_receipts','cleanup','receipt_database_name','validate_database_snapshot']
functions='\n'.join(re.search(r'^'+name+r'\(\) \{\n.*?^\}\n',source,re.M|re.S)[0] for name in names)
tail=source[source.index('  cache_private_receipt\n  remove_private_receipts\n  completed_marker='):source.index('\ndone\nunset SAGAT_TEST_AS_RUNTIME_ROLE')]
results=[]
for case in ['success','failure','mismatch','ambiguous','hash-failure','missing-receipt']:
 phase=root/case;phase.mkdir(mode=0o700);(phase/'owner').mkdir(mode=0o700);(phase/'old-source').mkdir();receipt=phase/'owner/receipt.json'
 fields='format source_commit case role database_name database_url runtime_database_url tenant other_tenant namespace run workflow_version scope_id scheduler_owner handoff_run_version closed_source_cutoff forward_step_id forward_target_key producer_witness_sha256 closed_source_sha256'.split();v={k:'fixture-only' for k in fields};db='t_'+'a'*32;v.update(format='legacy-nonfinal-return-frontier-v1',source_commit='6c44a0e49670cf19660792cd1518d241e6c99b3b',case='nonfinal-return',role='owner',database_name='t_'+'b'*32 if case=='mismatch' else db)
 receipt.write_text(json.dumps(v));receipt.chmod(0o600);(phase/'owner/receipt.tmp').write_text('fixture-only');(phase/'before').write_text('');(phase/'owner/producer.started').write_text('probe');(phase/'MANIFEST').touch()
 additions=db+'\n'+('t_'+'c'*32+'\n' if case=='ambiguous' else '')
 setup=f'''set -euo pipefail
run_root='{phase}'
old_source="${{run_root}}/old-source"
manifest="${{run_root}}/MANIFEST"
fixture_case=nonfinal-return
role=owner
receipt="${{run_root}}/owner/receipt.json"
active_before="${{run_root}}/before"
producer_started_marker="${{run_root}}/owner/producer.started"
cleanup_receipt_database=''
cleanup_receipt_sha=''
receipt_established=0
receipt_cache_failed=0
'''
 stubs='''terminate_active_phase() { :; }
list_test_databases() { cat "${run_root}/additions"; }
drop_database() {
  [[ ! -e "${run_root}/owner/receipt.json" && ! -e "${run_root}/owner/receipt.tmp" && ! -e "${run_root}/owner/receipt.json.tmp" ]] || return 91
  printf '%s\\n' "$1" >> "${run_root}/dropped"
}
'''
 (phase/'additions').write_text(additions)
 script=setup+functions+stubs+('receipt_established=1\nrm \"${receipt}\"\n' if case=='missing-receipt' else '')+('sha256() { return 42; }\n' if case=='hash-failure' else '')+'trap cleanup EXIT\n'+('exit 7\n' if case in ['failure','mismatch'] else tail+'\n')
 path=phase/'probe.sh';path.write_text(script)
 r=subprocess.run(['bash',str(path)],capture_output=True,text=True,timeout=5);(phase/'output.txt').write_text(r.stdout+r.stderr)
 expected=0 if case=='success' else 7 if case=='failure' else 1
 assert r.returncode==expected,(case,r.returncode,r.stderr)
 dropped=(phase/'dropped').read_text().splitlines() if (phase/'dropped').exists() else []
 assert dropped==([db] if case in ['success','failure'] else []),(case,dropped)
 assert not list((phase/'owner').glob('receipt*'))
 digest=(phase/'MANIFEST').read_text();assert bool(re.search(r'owner-receipt-sha256 [0-9a-f]{64}',digest))==(case not in ['hash-failure','missing-receipt'])
 results.append({'case':case,'exit_code':r.returncode,'drop_count':len(dropped),'private_files_remaining':0,'receipt_hash_retained':case not in ['hash-failure','missing-receipt']})
(root/'results.json').write_text(json.dumps(results,indent=2)+'\n');print(json.dumps(results))
