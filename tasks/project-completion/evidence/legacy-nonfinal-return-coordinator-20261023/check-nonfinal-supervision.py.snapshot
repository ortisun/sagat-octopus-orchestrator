from pathlib import Path
import subprocess,os,sys,re,selectors,signal,json,time
root=Path('/tmp/sagat-completion-20261023/supervision');root.mkdir(mode=0o700,exist_ok=True)
source=Path('scripts/test-legacy-collection-output-view.sh').read_text()
outer=re.search("<<'SUPERVISOR'\n(.*?)\nSUPERVISOR",source,re.S)[1]
admin=re.search("<<'PSQL'\n(.*?)\nPSQL",source,re.S)[1]
phase=re.search("<<'PY' &\n(.*?)\nPY\n  active_phase_pid",source,re.S)[1]
for name,code in [('outer',outer),('admin',admin),('phase',phase)]:
 compile(code,name,'exec');(root/(name+'.py')).write_text(code)
child_code="import os,signal;signal.signal(signal.SIGTERM,signal.SIG_IGN);print(os.getpid(),flush=True);signal.pause()"
fake=root/'psql';fake.write_text('#!'+sys.executable+'\n'+child_code+'\n');fake.chmod(0o700)
bash=root/'early-exit.sh';bash.write_text("trap 'exit 0' TERM\n"+sys.executable+" -c '"+child_code+"' &\nwait\n")
results=[]
for name,args in [('phase',[sys.executable,str(root/'phase.py'),'30',str(root/'started'),sys.executable,'-c',child_code]),('admin',[sys.executable,str(root/'admin.py'),'-Atq']),('outer',[sys.executable,str(root/'outer.py'),str(bash)])]:
 env=dict(os.environ,SAGAT_Q5_SUPERVISED='1',SAGAT_TEST_DATABASE_URL='postgres://fixture-only/unused',PATH=str(root)+os.pathsep+os.environ['PATH'])
 p=subprocess.Popen(args,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,env=env,start_new_session=True)
 selector=selectors.DefaultSelector();selector.register(p.stdout,selectors.EVENT_READ)
 assert selector.select(5),name+' missing child readiness barrier'
 child=int(p.stdout.readline().strip());selector.close();stamp=time.monotonic();p.terminate()
 stdout,stderr=p.communicate(timeout=9)
 assert p.returncode==143,(name,p.returncode,stderr)
 state=subprocess.run(['ps','-o','stat=','-p',str(child)],capture_output=True,text=True,check=False).stdout.strip()
 assert not state or state.startswith('Z'),(name,'surviving native child',state)
 result={'case':name,'exit_code':p.returncode,'seconds_after_signal':round(time.monotonic()-stamp,2),'child_running':False,'barrier':'child published pid after installing TERM ignore'};results.append(result);print(json.dumps(result))
(root/'results.json').write_text(json.dumps(results,indent=2)+'\n')
