+//! Dormant immutable source-certification port, fixed ordinary-leaf V1 only.
+//!
+//! No source writer or production caller is implemented. One exact identity is the canonical
+//! receipt. Current authority precedes replay; creation CAS applies only on a receipt miss.
+//! Cancellation/uncertain COMMIT requires fresh same-identity reconciliation, never assumed rollback.
+//! Storage must prove the pinned source facts and preserve receipt/source retention before use.
+
+use std::future::Future;
+
+use sagat_domain::{
+    audit::AuditId,
+    definition::WorkflowVersionId,
+    execution::{ExecutionInstanceId, InstancePath, RunId},
+    identity::{NamespaceId, TenantId},
+    workflow::{CollectionSuccessShapeError, Digest, NodeId},
+};
+use time::OffsetDateTime;
+
+use crate::{
+    error::StoreError,
+    primitives::{CollectionScopeId, SchedulerAuthority},
+};
+
+/// Canonical source-fact identity, not an execution capability or a caller's closure assertion.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct LeafCollectionPathIdentity {
+    tenant_id: TenantId,
+    namespace_id: NamespaceId,
+    run_id: RunId,
+    path: InstancePath,
+}
+
+impl LeafCollectionPathIdentity {
+    /// # Errors
+    /// Only one root-owned iteration path is supported by this profile.
+    pub fn new(
+        tenant_id: TenantId,
+        namespace_id: NamespaceId,
+        run_id: RunId,
+        path: InstancePath,
+    ) -> Result<Self, LeafCollectionSuccessError> {
+        if path.depth() != 1 {
+            return Err(LeafCollectionSuccessError::UnsupportedPath);
+        }
+        Ok(Self {
+            tenant_id,
+            namespace_id,
+            run_id,
+            path,
+        })
+    }
+    #[must_use]
+    pub const fn tenant_id(&self) -> TenantId {
+        self.tenant_id
+    }
+    #[must_use]
+    pub const fn namespace_id(&self) -> NamespaceId {
+        self.namespace_id
+    }
+    #[must_use]
+    pub const fn run_id(&self) -> RunId {
+        self.run_id
+    }
+    #[must_use]
+    pub const fn path(&self) -> &InstancePath {
+        &self.path
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CertifyLeafCollectionSuccess {
+    pub identity: LeafCollectionPathIdentity,
+    /// Creation CAS only; an existing canonical record replays before this comparison.
+    pub expected_run_revision: u64,
+    /// Required on creation and replay; this data is not a live authority proof.
+    pub scheduler: SchedulerAuthority,
+}
+
+impl CertifyLeafCollectionSuccess {
+    /// Structural command bounds only. Does not check current revision or scheduler ownership.
+    ///
+    /// # Errors
+    /// Revisions are positive and must fit the platform's signed 64-bit source journal.
+    pub const fn validate(&self) -> Result<(), LeafCollectionSuccessError> {
+        if self.expected_run_revision == 0 || self.expected_run_revision >= (1_u64 << 63) {
+            Err(LeafCollectionSuccessError::InvalidRevision)
+        } else {
+            Ok(())
+        }
+    }
+}
+
+/// Closed source rules, including definition shape contract 1 and its checked producer invariants.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum LeafCollectionSuccessProfile {
+    OrdinaryLeafV1,
+}
+
+/// Trusted storage snapshot of a canonical source certification. Constructing this value or
+/// passing validate_structure does not establish that its facts exist in a database.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct LeafCollectionSuccessRecord {
+    pub identity: LeafCollectionPathIdentity,
+    pub profile: LeafCollectionSuccessProfile,
+    pub definition_version: WorkflowVersionId,
+    pub scope_id: CollectionScopeId,
+    pub body: NodeId,
+    pub return_instance: ExecutionInstanceId,
+    pub admitted_sequence: u64,
+    pub returned_sequence: u64,
+    pub checkpoint_sequence: u64,
+    pub checkpoint_result_digest: Digest,
+    pub finished_sequence: u64,
+    pub aggregate_result_digest: Digest,
+    pub owner_routed_sequence: u64,
+    pub certified_run_revision: u64,
+    pub certified_at: OffsetDateTime,
+    pub audit_id: AuditId,
+}
+
+impl LeafCollectionSuccessRecord {
+    /// Check only qualified return-path binding and V1 source-reference relationships. The store
+    /// must independently validate the actual pin, scope, journal, digests and complete local set.
+    ///
+    /// # Errors
+    /// A malformed stored snapshot is contradictory, not merely unfinished source work.
+    pub fn validate_structure(&self) -> Result<(), LeafCollectionSuccessError> {
+        let counters = [
+            self.admitted_sequence,
+            self.returned_sequence,
+            self.checkpoint_sequence,
+            self.finished_sequence,
+            self.owner_routed_sequence,
+            self.certified_run_revision,
+        ];
+        if counters
+            .into_iter()
+            .any(|value| value == 0 || value >= (1_u64 << 63))
+            || self.return_instance.path() != self.identity.path()
+            || self.admitted_sequence >= self.returned_sequence
+            || self.returned_sequence.checked_add(1) != Some(self.checkpoint_sequence)
+            || self.checkpoint_sequence >= self.finished_sequence
+            || self.finished_sequence.checked_add(1) != Some(self.owner_routed_sequence)
+            || self.owner_routed_sequence > self.certified_run_revision
+        {
+            return Err(LeafCollectionSuccessError::ContradictorySource);
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct LeafCollectionSuccessResult {
+    pub record: LeafCollectionSuccessRecord,
+    pub replayed: bool,
+}
+
+#[derive(Clone, PartialEq, Eq, thiserror::Error)]
+pub enum LeafCollectionSuccessError {
+    #[error("unsupported source path")]
+    UnsupportedPath,
+    #[error("source resource is missing")]
+    Missing,
+    #[error("unsupported definition shape: {0}")]
+    UnsupportedShape(#[from] CollectionSuccessShapeError),
+    #[error("unsupported stored source profile")]
+    UnsupportedStoredProfile,
+    #[error("scheduler ownership changed")]
+    SchedulerFenceLost,
+    #[error("run revision changed")]
+    StaleRunRevision { current: u64 },
+    #[error("source is not closed")]
+    SourceNotClosed,
+    #[error("required retained source evidence is missing")]
+    SourceEvidenceMissing,
+    #[error("source evidence is contradictory")]
+    ContradictorySource,
+    #[error("invalid source revision")]
+    InvalidRevision,
+    #[error("confirmed storage failure")]
+    Storage(#[from] StoreError),
+    #[error("certification commit outcome is unknown")]
+    CommitOutcomeUnknown {
+        identity: LeafCollectionPathIdentity,
+    },
+}
+
+// Preserve the diagnostic source for explicit internal inspection without including it (or the
+// uncertain command identity) in ordinary error logging. Explicit source-chain formatting still
+// requires redaction at the caller boundary.
+impl std::fmt::Debug for LeafCollectionSuccessError {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        std::fmt::Display::fmt(self, formatter)
+    }
+}
+
+/// No implementation is supplied here. A future adapter must follow the reviewed exact guard,
+/// authority/replay/CAS/source-proof/commit order and atomic canonical-record/audit contract.
+pub trait LeafCollectionSuccessStore: Send + Sync {
+    fn certify_leaf_collection_success(
+        &self,
+        command: &CertifyLeafCollectionSuccess,
+    ) -> impl Future<Output = Result<LeafCollectionSuccessResult, LeafCollectionSuccessError>> + Send;
+}
diff --git a/crates/application/tests/leaf_certification.rs b/crates/application/tests/leaf_certification.rs
new file mode 100644
index 00000000..170da830
--- /dev/null
+++ b/crates/application/tests/leaf_certification.rs
@@ -0,0 +1,212 @@
+//! Structural API checks only; no source writer, canonical row or recovery proof.
+#![allow(clippy::expect_used)]
+
+use sagat_application::leaf_certification::{
+    CertifyLeafCollectionSuccess, LeafCollectionPathIdentity, LeafCollectionSuccessError as Error,
+    LeafCollectionSuccessProfile, LeafCollectionSuccessRecord,
+};
+use sagat_application::primitives::{CollectionScopeId, SchedulerAuthority};
+use sagat_domain::{
+    audit::AuditId,
+    definition::WorkflowVersionId,
+    execution::{ExecutionInstanceId, InstancePath, RunId},
+    identity::{NamespaceId, TenantId},
+    workflow::{Digest, NodeId},
+};
+use std::collections::HashSet;
+use uuid::Uuid;
+
+fn id(value: &str) -> NodeId {
+    NodeId::parse(value).expect("node")
+}
+fn path(owner: &str, index: u32) -> InstancePath {
+    InstancePath::root().child(id(owner), index).expect("path")
+}
+fn identity() -> LeafCollectionPathIdentity {
+    LeafCollectionPathIdentity::new(
+        TenantId::new(Uuid::from_u128(1)),
+        NamespaceId::new(Uuid::from_u128(2)),
+        RunId::new(Uuid::from_u128(3)),
+        path("items", 4),
+    )
+    .expect("depth-one identity")
+}
+fn record() -> LeafCollectionSuccessRecord {
+    let identity = identity();
+    LeafCollectionSuccessRecord {
+        profile: LeafCollectionSuccessProfile::OrdinaryLeafV1,
+        definition_version: WorkflowVersionId::new(Uuid::from_u128(5)),
+        scope_id: CollectionScopeId::new(Uuid::from_u128(6)),
+        body: id("line"),
+        return_instance: ExecutionInstanceId::in_path(identity.path().clone(), id("returned")),
+        admitted_sequence: 2,
+        returned_sequence: 8,
+        checkpoint_sequence: 9,
+        checkpoint_result_digest: Digest::new([0x11; 32]),
+        finished_sequence: 12,
+        aggregate_result_digest: Digest::new([0x22; 32]),
+        owner_routed_sequence: 13,
+        certified_run_revision: 20,
+        certified_at: time::OffsetDateTime::UNIX_EPOCH,
+        audit_id: AuditId::new(Uuid::from_u128(7)),
+        identity,
+    }
+}
+
+#[test]
+fn identity_is_exactly_depth_one_and_preserves_shared_qualifiers() {
+    let exact = identity();
+    assert_eq!(exact.tenant_id(), TenantId::new(Uuid::from_u128(1)));
+    assert_eq!(exact.namespace_id(), NamespaceId::new(Uuid::from_u128(2)));
+    assert_eq!(exact.run_id(), RunId::new(Uuid::from_u128(3)));
+    assert_eq!(
+        exact.path().scope_owner(),
+        Some(ExecutionInstanceId::root(id("items")))
+    );
+    for wrong in [
+        InstancePath::root(),
+        path("items", 4)
+            .child(id("nested"), 0)
+            .expect("deeper path"),
+    ] {
+        assert_eq!(
+            LeafCollectionPathIdentity::new(
+                exact.tenant_id(),
+                exact.namespace_id(),
+                exact.run_id(),
+                wrong
+            ),
+            Err(Error::UnsupportedPath)
+        );
+    }
+}
+
+#[test]
+fn canonical_identity_never_drops_tenant_namespace_run_owner_or_index() {
+    let base = identity();
+    let mut identities = HashSet::from([base.clone()]);
+    for (tenant, namespace, run, member) in [
+        (
+            TenantId::new(Uuid::from_u128(10)),
+            base.namespace_id(),
+            base.run_id(),
+            base.path().clone(),
+        ),
+        (
+            base.tenant_id(),
+            NamespaceId::new(Uuid::from_u128(10)),
+            base.run_id(),
+            base.path().clone(),
+        ),
+        (
+            base.tenant_id(),
+            base.namespace_id(),
+            RunId::new(Uuid::from_u128(10)),
+            base.path().clone(),
+        ),
+        (
+            base.tenant_id(),
+            base.namespace_id(),
+            base.run_id(),
+            path("other", 4),
+        ),
+        (
+            base.tenant_id(),
+            base.namespace_id(),
+            base.run_id(),
+            path("items", 5),
+        ),
+    ] {
+        assert!(identities.insert(
+            LeafCollectionPathIdentity::new(tenant, namespace, run, member).expect("identity")
+        ));
+    }
+    assert_eq!(identities.len(), 6);
+    assert!(!identities.insert(base));
+}
+
+#[test]
+fn creation_cas_bounds_are_checked_but_renewable_authority_does_not_change_identity() {
+    let identity = identity();
+    let mut command = CertifyLeafCollectionSuccess {
+        scheduler: SchedulerAuthority::for_run("first", identity.run_id(), 1),
+        identity: identity.clone(),
+        expected_run_revision: 1,
+    };
+    for valid in [1, (1_u64 << 63) - 1] {
+        command.expected_run_revision = valid;
+        assert_eq!(command.validate(), Ok(()));
+    }
+    for invalid in [0, 1_u64 << 63, u64::MAX] {
+        command.expected_run_revision = invalid;
+        assert_eq!(command.validate(), Err(Error::InvalidRevision));
+    }
+    command.scheduler = SchedulerAuthority::for_run("renewed", identity.run_id(), 2);
+    assert_eq!(command.identity, identity);
+}
+
+#[test]
+fn v1_record_uses_existing_distinct_reduction_and_checkpoint_references() {
+    let mut record = record();
+    assert_ne!(
+        record.checkpoint_result_digest,
+        record.aggregate_result_digest
+    );
+    assert_eq!(record.validate_structure(), Ok(()));
+    // Activity in another scope can advance this revision after the closed path's routing.
+    record.certified_run_revision = (1_u64 << 63) - 1;
+    assert_eq!(record.validate_structure(), Ok(()));
+}
+
+#[test]
+fn malformed_source_sequence_snapshots_fail_without_arithmetic_overflow() {
+    for (admitted, returned, checkpoint, finished, routed, revision) in [
+        (0, 8, 9, 12, 13, 20),
+        (8, 8, 9, 12, 13, 20),
+        (2, 8, 10, 12, 13, 20),
+        (2, 8, 9, 9, 10, 20),
+        (2, 8, 9, 12, 14, 20),
+        (2, 8, 9, 12, 13, 12),
+        (2, u64::MAX, 0, 12, 13, 20),
+        (2, 8, 9, u64::MAX, 0, u64::MAX),
+        (2, 8, 9, 12, 13, 1_u64 << 63),
+    ] {
+        let mut record = record();
+        record.admitted_sequence = admitted;
+        record.returned_sequence = returned;
+        record.checkpoint_sequence = checkpoint;
+        record.finished_sequence = finished;
+        record.owner_routed_sequence = routed;
+        record.certified_run_revision = revision;
+        assert_eq!(record.validate_structure(), Err(Error::ContradictorySource));
+    }
+}
+
+#[test]
+fn a_return_from_another_path_cannot_satisfy_structural_record_binding() {
+    let mut record = record();
+    for wrong in [InstancePath::root(), path("items", 5), path("other", 4)] {
+        record.return_instance = ExecutionInstanceId::in_path(wrong, id("returned"));
+        assert_eq!(record.validate_structure(), Err(Error::ContradictorySource));
+    }
+}
+
+#[test]
+fn error_formatting_keeps_storage_diagnostics_and_path_text_private() {
+    let canary = "sk-live1234567890abcdef";
+    let error = Error::Storage(sagat_application::error::StoreError::Internal {
+        detail: format!("driver text with {canary}"),
+    });
+    assert!(!error.to_string().contains(canary));
+    assert!(!format!("{error:?}").contains(canary));
+    let identity = LeafCollectionPathIdentity::new(
+        identity().tenant_id(),
+        identity().namespace_id(),
+        identity().run_id(),
+        path(canary, 0),
+    )
+    .expect("synthetic secret-shaped node identity");
+    let error = Error::CommitOutcomeUnknown { identity };
+    assert!(!error.to_string().contains(canary));
+    assert!(!format!("{error:?}").contains(canary));
+}
