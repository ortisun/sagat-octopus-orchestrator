+        "steps",
+        "checkpoints",
+        "items",
+        "payloads",
+        "receipts",
+        "usage",
+        "iteration_usage",
+        "sagas",
+        "saga_entries",
+    ] {
+        assert!(
+            before[key] == after[key],
+            "first guard preserves source, active reservations, outputs and original receipts"
