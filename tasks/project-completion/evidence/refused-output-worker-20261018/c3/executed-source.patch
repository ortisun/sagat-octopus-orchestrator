 #[tokio::test(flavor = "current_thread")]
 async fn a_late_receipt_fault_rolls_back_the_whole_successful_refusal_and_same_key_retries() {
     let name = format!("scoped-refusal-fault-{}", uuid::Uuid::now_v7());
