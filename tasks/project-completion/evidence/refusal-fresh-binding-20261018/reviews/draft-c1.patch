+fn without_binding_withdrawal(snapshot: &Value) -> Value {
+    let mut stable = snapshot.clone();
+    stable
+        .as_object_mut()
+        .expect("refusal snapshot object")
+        .remove("audits");
+    for step in stable["steps"]
+        .as_array_mut()
+        .expect("refusal snapshot steps")
+    {
+        let step = step.as_object_mut().expect("refusal snapshot step");
+        step.remove("lease_expires_at");
+        step.remove("updated_at");
+    }
+    stable
+}
