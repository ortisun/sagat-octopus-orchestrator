diff --git a/tests/integration/workflow-primitives/bounded_fences.rs b/tests/integration/workflow-primitives/bounded_fences.rs
index b25d3579..88678b59 100644
--- a/tests/integration/workflow-primitives/bounded_fences.rs
+++ b/tests/integration/workflow-primitives/bounded_fences.rs
@@ -480,3 +480,25 @@ pub(super) async fn chain_checkpoint(
     .await
     .expect("independent chain effects checkpoint")
 }
+
+/// One independent snapshot of the persisted effects owned by collection/loop transitions.
+pub(super) async fn scope_checkpoint(pool: &sqlx::PgPool, tenant: uuid::Uuid) -> serde_json::Value {
+    // Static test-owned identifiers only; the tenant remains a bound SQL value.
+    let entries = [
+        "runs", "steps", "run_events", "event_outbox", "audit_records", "payloads",
+        "iteration_scopes", "collection_scope_items", "collection_iterations", "iteration_checkpoints",
+        "loop_scopes", "loop_iterations", "loop_checkpoints", "loop_timers",
+        "run_instance_usage", "tenant_iteration_usage", "tenant_retained_usage",
+    ]
+    .iter()
+    .map(|table| format!(
+        "'{table}',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM {table} t WHERE t.tenant_id=$1)"
+    ))
+    .collect::<Vec<_>>()
+    .join(",");
+    sqlx::query_scalar(&format!("SELECT jsonb_build_object({entries})"))
+        .bind(tenant)
+        .fetch_one(pool)
+        .await
+        .expect("independent scope effects checkpoint")
+}
diff --git a/tests/integration/workflow-primitives/loop_progress.rs b/tests/integration/workflow-primitives/loop_progress.rs
index e960d676..a8108b12 100644
--- a/tests/integration/workflow-primitives/loop_progress.rs
+++ b/tests/integration/workflow-primitives/loop_progress.rs
@@ -3998,3 +3998,75 @@ async fn loop_entry_and_checkpoint_are_written_by_the_least_privilege_runtime_ro
         .expect("and replays the checkpoint");
     assert!(!replay.applied);
 }
+
+#[tokio::test]
+async fn scope_post_wait_fence_rejects_loop_entry_after_expiry_without_effects() {
+    assert_loop_entry_post_wait(false).await;
+}
+
+#[tokio::test]
+async fn scope_post_wait_fence_preserves_loop_generation_storage_error() {
+    assert_loop_entry_post_wait(true).await;
+}
+
+async fn assert_loop_entry_post_wait(overflow: bool) {
+    use crate::bounded_fences::{SchedulerExpiryBarrier, scope_checkpoint};
+    let fixture = seed_pending_loop("loop-postwait").await;
+    let store =
+        PgLoopProgressStore::new(fixture.db.runtime_pool().await, fixture.definitions.clone());
+    let authority = if overflow {
+        SchedulerAuthority::for_run(fixture.authority.owner(), fixture.run, u64::MAX)
+    } else {
+        fixture.authority.clone()
+    };
+    let outbox = Uuid::now_v7();
+    let prepared = entry_command(&fixture, authority, outbox, crate::support::now());
+    let before = scope_checkpoint(&fixture.db.pool, fixture.tenant).await;
+    let result = if overflow {
+        store.enter_loop(&prepared).await
+    } else {
+        let barrier = SchedulerExpiryBarrier::hold(&fixture.db.pool, fixture.run).await;
+        let (result, ()) = tokio::join!(store.enter_loop(&prepared), barrier.expire_after_wait());
+        result
+    };
+    let error = result.expect_err("invalid scheduler authority must refuse loop entry");
+    if overflow {
+        assert!(matches!(
+            error,
+            LoopProgressError::Storage(StoreError::Internal { .. })
+        ));
+    } else {
+        assert_eq!(error, LoopProgressError::SchedulerFenceLost);
+    }
+    assert_eq!(
+        scope_checkpoint(&fixture.db.pool, fixture.tenant).await,
+        before
+    );
+    if !overflow {
+        let fresh = entry_command(
+            &fixture,
+            scheduler(&fixture.db.pool, fixture.run).await,
+            outbox,
+            crate::support::now(),
+        );
+        assert!(
+            store
+                .enter_loop(&fresh)
+                .await
+                .expect("fresh loop entry")
+                .applied
+        );
+        let committed = scope_checkpoint(&fixture.db.pool, fixture.tenant).await;
+        assert!(
+            !store
+                .enter_loop(&fresh)
+                .await
+                .expect("exact loop replay")
+                .applied
+        );
+        assert_eq!(
+            scope_checkpoint(&fixture.db.pool, fixture.tenant).await,
+            committed
+        );
+    }
+}
