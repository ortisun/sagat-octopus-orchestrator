+
+/// One independent snapshot of the persisted effects owned by collection/loop transitions.
+pub(super) async fn scope_checkpoint(pool: &sqlx::PgPool, tenant: uuid::Uuid) -> serde_json::Value {
+    sqlx::query_scalar(
+        "SELECT jsonb_build_object( \
+         'runs',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM runs t WHERE t.tenant_id=$1), \
+         'steps',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM steps t WHERE t.tenant_id=$1), \
+         'run_events',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM run_events t WHERE t.tenant_id=$1), \
+         'event_outbox',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM event_outbox t WHERE t.tenant_id=$1), \
+         'audit_records',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM audit_records t WHERE t.tenant_id=$1), \
+         'payloads',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM payloads t WHERE t.tenant_id=$1), \
+         'iteration_scopes',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM iteration_scopes t WHERE t.tenant_id=$1), \
+         'collection_scope_items',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM collection_scope_items t WHERE t.tenant_id=$1), \
+         'collection_iterations',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM collection_iterations t WHERE t.tenant_id=$1), \
+         'iteration_checkpoints',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM iteration_checkpoints t WHERE t.tenant_id=$1), \
+         'loop_scopes',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM loop_scopes t WHERE t.tenant_id=$1), \
+         'loop_iterations',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM loop_iterations t WHERE t.tenant_id=$1), \
+         'loop_checkpoints',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM loop_checkpoints t WHERE t.tenant_id=$1), \
+         'loop_timers',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM loop_timers t WHERE t.tenant_id=$1), \
+         'run_instance_usage',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM run_instance_usage t WHERE t.tenant_id=$1), \
+         'tenant_iteration_usage',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM tenant_iteration_usage t WHERE t.tenant_id=$1), \
+         'tenant_retained_usage',(SELECT jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text) FROM tenant_retained_usage t WHERE t.tenant_id=$1))",
+    )
+    .bind(tenant)
+    .fetch_one(pool)
+    .await
+    .expect("independent scope effects checkpoint")
+}
diff --git a/tests/integration/workflow-primitives/loop_progress.rs b/tests/integration/workflow-primitives/loop_progress.rs
index e960d676..3f66d00c 100644
--- a/tests/integration/workflow-primitives/loop_progress.rs
+++ b/tests/integration/workflow-primitives/loop_progress.rs
@@ -3998,3 +3998,97 @@ async fn loop_entry_and_checkpoint_are_written_by_the_least_privilege_runtime_ro
         .expect("and replays the checkpoint");
     assert!(!replay.applied);
 }
+
+#[tokio::test]
+async fn scope_post_wait_fence_rejects_loop_entry_after_expiry_without_effects() {
+    assert_loop_entry_post_wait(false).await;
+}
+
+#[tokio::test]
+async fn scope_post_wait_fence_preserves_loop_generation_storage_error() {
+    assert_loop_entry_post_wait(true).await;
+}
+
+async fn assert_loop_entry_post_wait(overflow: bool) {
+    use crate::bounded_fences::{SchedulerExpiryBarrier, scope_checkpoint};
+    let fixture = seed_pending_loop("loop-postwait").await;
+    let store =
+        PgLoopProgressStore::new(fixture.db.runtime_pool().await, fixture.definitions.clone());
+    let authority = if overflow {
+        SchedulerAuthority::for_run(fixture.authority.owner(), fixture.run, u64::MAX)
+    } else {
+        fixture.authority.clone()
+    };
+    let outbox = Uuid::now_v7();
+    let carry_digest = digest(b"1");
+    let retained: bool = sqlx::query_scalar(
+        "SELECT EXISTS(SELECT 1 FROM payloads WHERE tenant_id=$1 AND digest=$2)",
+    )
+    .bind(fixture.tenant)
+    .bind(carry_digest.as_bytes().as_slice())
+    .fetch_one(&fixture.db.pool)
+    .await
+    .expect("novel carry check");
+    assert!(
+        !retained,
+        "the failed entry must not retain a new carry payload"
+    );
+    let command = |authority| {
+        let occurred_at = crate::support::now();
+        LoopEntryCommand::from_carry(
+            transition(&fixture, 1, authority, audit(&fixture), occurred_at),
+            LoopKind::While,
+            3,
+            occurred_at + Duration::minutes(1),
+            b"1".to_vec(),
+            Some(true),
+            Some(next_activity(&fixture, 0)),
+            outbox,
+        )
+        .expect("entry with new carry")
+    };
+    let prepared = command(authority);
+    let before = scope_checkpoint(&fixture.db.pool, fixture.tenant).await;
+    let result = if overflow {
+        store.enter_loop(&prepared).await
+    } else {
+        let barrier = SchedulerExpiryBarrier::hold(&fixture.db.pool, fixture.run).await;
+        let (result, ()) = tokio::join!(store.enter_loop(&prepared), barrier.expire_after_wait());
+        result
+    };
+    let error = result.expect_err("invalid scheduler authority must refuse loop entry");
+    if overflow {
+        assert!(matches!(
+            error,
+            LoopProgressError::Storage(StoreError::Internal { .. })
+        ));
+    } else {
+        assert_eq!(error, LoopProgressError::SchedulerFenceLost);
+    }
+    assert_eq!(
+        scope_checkpoint(&fixture.db.pool, fixture.tenant).await,
+        before
+    );
+    if !overflow {
+        let fresh = command(scheduler(&fixture.db.pool, fixture.run).await);
+        assert!(
+            store
+                .enter_loop(&fresh)
+                .await
+                .expect("fresh loop entry")
+                .applied
+        );
+        let committed = scope_checkpoint(&fixture.db.pool, fixture.tenant).await;
+        assert!(
+            !store
+                .enter_loop(&fresh)
+                .await
+                .expect("exact loop replay")
+                .applied
+        );
+        assert_eq!(
+            scope_checkpoint(&fixture.db.pool, fixture.tenant).await,
+            committed
+        );
+    }
+}
diff --git a/tests/integration/workflow-primitives/primitive_transactions.rs b/tests/integration/workflow-primitives/primitive_transactions.rs
index e3763363..52778f16 100644
--- a/tests/integration/workflow-primitives/primitive_transactions.rs
+++ b/tests/integration/workflow-primitives/primitive_transactions.rs
@@ -2355,3 +2355,105 @@ async fn persisted_tenant_capacity_serializes_admission_across_runs() {
     .expect("tenant contention result");
     assert_eq!(persisted, (1, 1));
 }
+
+#[tokio::test]
+async fn scope_post_wait_fence_rejects_collection_entry_after_expiry_without_effects() {
+    assert_collection_entry_post_wait(false).await;
+}
+
+#[tokio::test]
+async fn scope_post_wait_fence_preserves_collection_generation_storage_error() {
+    assert_collection_entry_post_wait(true).await;
+}
+
+async fn assert_collection_entry_post_wait(overflow: bool) {
+    use crate::bounded_fences::{SchedulerExpiryBarrier, scope_checkpoint};
+    let w = world().await;
+    let owner = ExecutionInstanceId::root(NodeId::parse("items").expect("scope owner"));
+    let (workflow, version, definitions) =
+        publish_collection_fixture(&w, "collection-postwait", "items").await;
+    let run = journaled_collection_run(&w, workflow, version, &owner).await;
+    let tenant = w.admin.tenant_id().as_uuid();
+    let authority = scheduler_authority(&w.db.pool, run).await;
+    set_tenant_collection_capacity(&w.db.pool, tenant, 1).await;
+    let snapshot = retain_payload(&w.db.pool, tenant, b"[1]").await;
+    let scope = CollectionScopeId::generate();
+    let store = PgCollectionStore::with_definition_cache(w.db.runtime_pool().await, definitions);
+    let command = |authority| {
+        CollectionEntry::new(
+            transition_with_audit(
+                &w,
+                run,
+                1,
+                owner.clone(),
+                authority,
+                AuditRecord::engine(
+                    w.admin.tenant_id(),
+                    AuditAction::RunUpdated,
+                    ResourceType::Run,
+                    run.to_string(),
+                    "collection entry fence",
+                    Some("0af7651916cd43dd8448eb211c80319c".into()),
+                    crate::support::now(),
+                ),
+            ),
+            scope,
+            1,
+            snapshot,
+            CollectionLimits::new(1, 1, 100_000, 8).expect("limits"),
+        )
+        .expect("collection entry")
+    };
+    let claimed = if overflow {
+        SchedulerAuthority::for_run(authority.owner(), run, u64::MAX)
+    } else {
+        authority
+    };
+    let prepared = command(claimed);
+    let before = scope_checkpoint(&w.db.pool, tenant).await;
+    let result = if overflow {
+        store.enter_collection(&prepared).await
+    } else {
+        let barrier = SchedulerExpiryBarrier::hold(&w.db.pool, run).await;
+        let (result, ()) = tokio::join!(
+            store.enter_collection(&prepared),
+            barrier.expire_after_wait()
+        );
+        result
+    };
+    let error = result.expect_err("invalid scheduler authority must refuse collection entry");
+    if overflow {
+        assert!(matches!(
+            error,
+            PrimitiveStoreError::Storage(sagat_application::error::StoreError::Internal { .. })
+        ));
+    } else {
+        assert_eq!(error, PrimitiveStoreError::SchedulerFenceLost);
+    }
+    assert_eq!(scope_checkpoint(&w.db.pool, tenant).await, before);
+    if !overflow {
+        let fresh = command(scheduler_authority(&w.db.pool, run).await);
+        assert!(
+            store
+                .enter_collection(&fresh)
+                .await
+                .expect("fresh entry")
+                .applied
+        );
+        let audits: i64 = sqlx::query_scalar(
+            "SELECT count(*) FROM audit_records WHERE tenant_id=$1 AND resource_id=$2 \
+             AND action='run.updated' AND reason='collection entry fence' AND trace_id ~ '^[0-9a-f]{32}$'",
+        )
+        .bind(tenant).bind(run.to_string()).fetch_one(&w.db.pool).await.expect("entry audit count");
+        assert_eq!(audits, 1, "entry commits its supplied audit exactly once");
+        let committed = scope_checkpoint(&w.db.pool, tenant).await;
+        assert!(
+            !store
+                .enter_collection(&fresh)
+                .await
+                .expect("exact entry replay")
+                .applied
+        );
+        assert_eq!(scope_checkpoint(&w.db.pool, tenant).await, committed);
+    }
+}
