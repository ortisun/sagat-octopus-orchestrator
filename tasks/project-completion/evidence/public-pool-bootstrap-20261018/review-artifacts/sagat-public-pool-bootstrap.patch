+         FROM command_dedupe WHERE tenant_id=$1 AND scope=$2 AND idempotency_key=$3",
+    )
+    .bind(tenant.as_uuid())
+    .bind(scope)
+    .bind(idempotency_key)
+    .fetch_one(pool)
+    .await
+    .expect("read exact public completion receipt")
+}
