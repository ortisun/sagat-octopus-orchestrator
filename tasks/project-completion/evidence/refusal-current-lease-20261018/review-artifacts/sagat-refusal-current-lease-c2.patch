+struct RefusalLeaseFence {
+    status: String,
+    lease_token_hash: Vec<u8>,
+    attempt: i32,
+    generation: i64,
+    leased_by: String,
+    lease_expires_at: time::OffsetDateTime,
+    updated_at: time::OffsetDateTime,
+    cancel_requested: bool,
+    output_absent: bool,
+    reported_lease_absent: bool,
+    database_time: time::OffsetDateTime,
