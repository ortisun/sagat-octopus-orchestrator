SELECT json_build_object(
'database',current_database(),'inspection_user',current_user,
'run_count',(SELECT count(*) FROM runs),
'run_status',r.status,'stop_reason',r.stop_reason,'stop_code',r.stop_code,'run_version',r.run_version,
'original_status',s.status,'original_output_absent',s.output_digest IS NULL,
'original_attempt',s.attempt,'original_generation',s.generation,
'reported_hash_width',octet_length(s.reported_lease_token_hash),
'logical_output_bytes',(SELECT logical_output_bytes FROM run_instance_usage WHERE run_id=r.id),
'retained_x_steps',(SELECT count(*) FROM steps WHERE run_id=r.id AND node='reserve' AND status='SUCCEEDED' AND output_digest=decode('2b5ae2c4733ecdaf725ae45fcd05a7149a63c1884a61a100aed3cb35f2745e22','hex')),
'retained_x_reference_bytes',(SELECT sum(octet_length(p.content)) FROM steps st JOIN payloads p ON p.tenant_id=st.tenant_id AND p.digest=st.output_digest WHERE st.run_id=r.id AND st.node='reserve'),
'candidate_payloads',(SELECT count(*) FROM payloads WHERE tenant_id=r.tenant_id AND digest=decode('b375a2ff6e503ca226b4aaab915a135a36cc069adc8986b5a3eed6ee3479e49e','hex')),
'completed_event_payloads',(SELECT count(*) FROM run_events WHERE run_id=r.id AND event_type='step.completed' AND node='reserve' AND instance_path_indices=ARRAY[16]::integer[] AND payload_digest IS NOT NULL),
'original_completions',(SELECT count(*) FROM run_events WHERE run_id=r.id AND event_type='step.completed' AND node='reserve' AND instance_path_indices=ARRAY[16]::integer[]),
'stop_events',(SELECT count(*) FROM run_events WHERE run_id=r.id AND event_type='run.stop_requested' AND detail->>'reason'='FAILED' AND detail->>'code'='RUN_DATA_LIMIT'),
'checkpoints',(SELECT count(*) FROM iteration_checkpoints WHERE run_id=r.id),
'active_iterations',(SELECT active_iterations FROM tenant_iteration_usage WHERE tenant_id=r.tenant_id),
'scope_lifecycle',(SELECT lifecycle FROM iteration_scopes WHERE run_id=r.id),
'original_slot_held',(SELECT slot_held FROM collection_iterations WHERE run_id=r.id AND iteration_index=16),
'new_return_steps',(SELECT count(*) FROM steps WHERE run_id=r.id AND node='returned' AND instance_path_indices=ARRAY[16]::integer[]),
'sagas',(SELECT count(*) FROM scope_sagas WHERE run_id=r.id),
'drain_outbox',(SELECT count(*) FROM event_outbox WHERE aggregate_id=r.id AND event_type='collection.drain.started'),
'head_matches',(SELECT head_seq=r.run_version FROM telemetry_pending WHERE run_id=r.id),
'refusal_receipt_count',(SELECT count(*) FROM command_dedupe WHERE tenant_id=r.tenant_id AND idempotency_key LIKE 'public-refusal-%'),
'canonical_receipt_scope',(SELECT scope='step:'||r.id||':scoped:5:lines:16;7:reserve:'||encode(substring(s.reported_lease_token_hash FROM 1 FOR 8),'hex') FROM command_dedupe WHERE tenant_id=r.tenant_id AND idempotency_key LIKE 'public-refusal-%'),
'canonical_receipt_resource',(SELECT resource_id='SUCCEEDED|CANCELLING|'||r.run_version FROM command_dedupe WHERE tenant_id=r.tenant_id AND idempotency_key LIKE 'public-refusal-%'),
'receipt_hash',(SELECT encode(request_hash,'hex') FROM command_dedupe WHERE tenant_id=r.tenant_id AND idempotency_key LIKE 'public-refusal-%'),
'fixed_refusal_audits',(SELECT count(*) FROM audit_records WHERE tenant_id=r.tenant_id AND action='run.data_limit_exceeded' AND actor='system:engine' AND reason='successful scoped output refused by run data limit' AND trace_id IS NOT DISTINCT FROM r.trace_id),
'gate_triggers',(SELECT count(*) FROM pg_trigger WHERE tgname='public_refusal_receipt_gate'))
FROM runs r JOIN steps s ON s.tenant_id=r.tenant_id AND s.run_id=r.id AND s.node='reserve' AND s.instance_path_indices=ARRAY[16]::integer[]
