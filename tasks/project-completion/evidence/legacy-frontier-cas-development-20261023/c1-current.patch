+fn cas_counter(name: &str, labels: &[(&str, &str)]) -> f64 {
+    sagat_telemetry::Metrics::global()
+        .render()
+        .lines()
+        .filter(|line| {
+            line.starts_with(&format!("{name}{{"))
+                && labels
+                    .iter()
+                    .all(|(key, value)| line.contains(&format!("{key}=\"{value}\"")))
+        })
+        .filter_map(|line| line.split_whitespace().last()?.parse::<f64>().ok())
+        .sum()
+}
