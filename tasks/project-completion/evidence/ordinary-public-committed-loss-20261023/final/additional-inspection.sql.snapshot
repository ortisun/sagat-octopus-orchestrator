SELECT json_build_object('journal_head',(SELECT max(seq) FROM run_events),'gate_triggers',(SELECT count(*) FROM pg_trigger WHERE tgname IN ('public_refusal_receipt_gate','public_refusal_commit_gate')),'gate_functions',(SELECT count(*) FROM pg_proc WHERE proname IN ('public_refusal_receipt_gate','public_refusal_commit_probe')),'proxy_connections',(SELECT count(*) FROM pg_stat_activity WHERE datname=current_database() AND application_name='sagat-test-capacity-commit-loss'))
