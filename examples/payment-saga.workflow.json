{
  "apiVersion": "sagat-octopus-orchestrator.io/v1",
  "kind": "Workflow",
  "metadata": {
    "name": "corporate-payment",
    "description": "Example saga that reserves the limit, submits the payment, compensates the reservation if the submission fails, and reconciles a submission whose response was lost"
  },
  "entrypoint": "validate",
  "triggers": [
    {
      "kind": "manual"
    }
  ],
  "inputSchema": {
    "type": "object",
    "required": [
      "paymentId",
      "amount"
    ],
    "properties": {
      "paymentId": {
        "type": "string"
      },
      "amount": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    }
  },
  "nodes": [
    {
      "id": "validate",
      "type": "activity",
      "activity": "payment.validate",
      "next": "settlement"
    },
    {
      "id": "settlement",
      "type": "saga",
      "begin": "reserve",
      "next": "wait_confirmation",
      "onCompensationFailure": "manual_review",
      "cancelPolicy": "compensate_completed"
    },
    {
      "id": "reserve",
      "type": "activity",
      "activity": "limit.reserve",
      "compensateWith": "limit.release",
      "idempotencyTemplate": "reserve:${run.id}",
      "next": "submit",
      "retry": {
        "maxAttempts": 3,
        "strategy": "exponential",
        "initialDelayMs": 500,
        "maxDelayMs": 10000,
        "jitter": true
      },
      "compensationRetry": {
        "maxAttempts": 5,
        "strategy": "exponential",
        "initialDelayMs": 2000,
        "maxDelayMs": 60000,
        "jitter": true
      }
    },
    {
      "id": "submit",
      "type": "activity",
      "activity": "payment.submit",
      "compensateWith": "payment.return.request",
      "reconcileWith": "payment.lookup.status",
      "idempotencyTemplate": "submit:${input.paymentId}",
      "retry": {
        "maxAttempts": 3,
        "strategy": "exponential",
        "initialDelayMs": 1000,
        "maxDelayMs": 30000,
        "jitter": true
      },
      "highRisk": true
    },
    {
      "id": "wait_confirmation",
      "type": "waitEvent",
      "eventType": "payment.confirmed",
      "correlationExpr": "input.paymentId",
      "timeoutMs": 300000,
      "next": "notify",
      "onTimeout": "manual_review"
    },
    {
      "id": "notify",
      "type": "activity",
      "activity": "customer.notify"
    },
    {
      "id": "manual_review",
      "type": "activity",
      "activity": "payment.manual-review"
    }
  ]
}
