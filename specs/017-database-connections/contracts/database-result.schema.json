{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sagat:database-result:v1",
  "title": "Bounded managed database result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "columns",
    "rows",
    "affectedRows",
    "truncated"
  ],
  "properties": {
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 63
          },
          "type": {
            "enum": [
              "null",
              "boolean",
              "integer",
              "decimal",
              "float",
              "text",
              "timestamp",
              "date",
              "binary",
              "json"
            ]
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/cell"
        }
      }
    },
    "affectedRows": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "truncated": {
      "const": false
    }
  },
  "$defs": {
    "cell": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "null"
            },
            "value": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "integer"
            },
            "value": {
              "type": "string",
              "pattern": "^-?[0-9]+$",
              "maxLength": 40
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "decimal"
            },
            "value": {
              "type": "string",
              "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
              "maxLength": 16384
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "float"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "timestamp"
            },
            "value": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "date"
            },
            "value": {
              "type": "string",
              "format": "date"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "binary"
            },
            "value": {
              "type": "string",
              "contentEncoding": "base64"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "json"
            },
            "value": {}
          }
        }
      ]
    }
  }
}
