{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagat-octopus-orchestrator.example/schemas/workflow/v1.json",
  "title": "Sagat Octopus Orchestrator Workflow IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "entrypoint",
    "nodes"
  ],
  "properties": {
    "apiVersion": {
      "const": "sagat-octopus-orchestrator.io/v1"
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object"
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "manual",
              "event",
              "cron",
              "webhook"
            ]
          },
          "eventType": {
            "type": "string"
          },
          "cron": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/activity"
        },
        {
          "$ref": "#/$defs/timer"
        },
        {
          "$ref": "#/$defs/waitEvent"
        },
        {
          "$ref": "#/$defs/condition"
        },
        {
          "$ref": "#/$defs/parallel"
        },
        {
          "$ref": "#/$defs/child"
        },
        {
          "$ref": "#/$defs/saga"
        },
        {
          "$ref": "#/$defs/script"
        },
        {
          "$ref": "#/$defs/foreach"
        },
        {
          "$ref": "#/$defs/humanApproval"
        },
        {
          "$ref": "#/$defs/end"
        }
      ]
    },
    "base": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "next": {
          "type": "string"
        },
        "onError": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "activity": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "activity"
          ],
          "properties": {
            "type": {
              "const": "activity"
            },
            "activity": {
              "type": "string"
            },
            "retry": {
              "$ref": "#/$defs/retry"
            },
            "compensateWith": {
              "type": "string",
              "description": "The activity that undoes this one. It runs when a saga around this node compensates, and must be idempotent and tolerate an effect that never happened."
            },
            "reconcileWith": {
              "type": "string",
              "description": "The activity that finds out whether this one happened, after an attempt with an unknown outcome. It answers {\"effect\": \"applied\"|\"not_applied\"|\"unknown\"} and, for applied, optionally {\"output\": ...}."
            },
            "idempotencyTemplate": {
              "type": "string"
            },
            "secrets": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "description": "Names of the secrets of the namespace the worker may ask for while it holds a lease on this step. Names only: a value is never part of a definition.",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              }
            },
            "compensationRetry": {
              "$ref": "#/$defs/retry",
              "description": "The retry budget of the compensation (compensateWith). Five attempts, exponential from two seconds to five minutes, with jitter when absent."
            },
            "compensationTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "description": "Longest one attempt of the compensation may take."
            },
            "irreversible": {
              "type": "boolean",
              "description": "The effect cannot be undone once it has happened. A saga that has to compensate past it ends PARTIAL. Cannot be combined with compensateWith."
            },
            "highRisk": {
              "type": "boolean",
              "description": "An attempt whose outcome is unknown (lease lost, timeout, OUTCOME_UNKNOWN) is never retried or compensated blindly: it is reconciled when reconcileWith says how, and otherwise waits for an operator."
            }
          }
        }
      ]
    },
    "timer": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "durationMs"
          ],
          "properties": {
            "type": {
              "const": "timer"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "waitEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "eventType",
            "correlationExpr",
            "timeoutMs"
          ],
          "properties": {
            "type": {
              "const": "waitEvent"
            },
            "eventType": {
              "type": "string"
            },
            "correlationExpr": {
              "type": "string"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "onTimeout": {
              "type": "string"
            }
          }
        }
      ]
    },
    "condition": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "expression",
            "ifTrue",
            "ifFalse"
          ],
          "properties": {
            "type": {
              "const": "condition"
            },
            "expression": {
              "type": "string"
            },
            "ifTrue": {
              "type": "string"
            },
            "ifFalse": {
              "type": "string"
            }
          }
        }
      ]
    },
    "parallel": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "branches",
            "join"
          ],
          "properties": {
            "type": {
              "const": "parallel"
            },
            "branches": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string"
              }
            },
            "join": {
              "enum": [
                "all",
                "any"
              ]
            },
            "next": {
              "type": "string"
            }
          }
        }
      ]
    },
    "child": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "workflowId"
          ],
          "properties": {
            "type": {
              "const": "child"
            },
            "workflowId": {
              "type": "string",
              "description": "Name of the workflow to start, resolved in the namespace of the parent run when the child starts."
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "description": "Pins a published version number; the workflow's active version when absent."
            },
            "input": {
              "type": "string",
              "description": "Expression over the parent's data that must evaluate to a JSON object (for example input.order or steps.charge.output); the parent's own input when absent."
            },
            "cancelPolicy": {
              "enum": [
                "propagate",
                "detach",
                "request_cancel"
              ],
              "description": "What happens to the child when the parent is stopped. propagate (default): the child is cancelled and the parent does not wait for it. request_cancel: the child is cancelled and the parent waits until it has settled. detach: the child keeps running."
            }
          }
        }
      ]
    },
    "saga": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "begin"
          ],
          "properties": {
            "type": {
              "const": "saga"
            },
            "begin": {
              "type": "string",
              "description": "The first node of the saga. Everything reachable from it is the body of the saga; the body is entered only from here and holds no end node. When it completes, control goes to next."
            },
            "onCompensationFailure": {
              "enum": [
                "manual_review",
                "fail"
              ],
              "description": "manual_review (default): a compensation that fails after its retries waits for an operator. fail: the saga ends COMPENSATION_FAILED."
            },
            "cancelPolicy": {
              "enum": [
                "compensate_completed",
                "abort_no_compensation",
                "wait_in_flight_then_compensate"
              ],
              "description": "What a cancellation or a deadline does to the saga. compensate_completed (default): stop what is in flight and compensate what completed. wait_in_flight_then_compensate: let the attempts in flight finish, then compensate everything that completed. abort_no_compensation: stop and compensate nothing."
            }
          }
        }
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "initialDelayMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxDelayMs": {
          "type": "integer",
          "minimum": 1
        },
        "strategy": {
          "enum": [
            "fixed",
            "exponential"
          ]
        },
        "jitter": {
          "type": "boolean"
        }
      }
    },
    "script": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "artifactDigest"
          ],
          "properties": {
            "type": {
              "const": "script"
            },
            "artifactDigest": {
              "type": "string",
              "minLength": 12
            },
            "language": {
              "enum": [
                "typescript",
                "python",
                "csharp",
                "go",
                "java"
              ]
            },
            "retry": {
              "$ref": "#/$defs/retry"
            },
            "compensateWith": {
              "type": "string"
            }
          }
        }
      ]
    },
    "foreach": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "collectionExpr",
            "itemKeyExpr",
            "body",
            "maxItems"
          ],
          "properties": {
            "type": {
              "const": "foreach"
            },
            "collectionExpr": {
              "type": "string"
            },
            "itemKeyExpr": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "maxItems": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxConcurrency": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "humanApproval": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "approverPolicy",
            "timeoutMs",
            "formSchema"
          ],
          "properties": {
            "type": {
              "const": "humanApproval"
            },
            "approverPolicy": {
              "type": "string"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "formSchema": {
              "type": "object"
            },
            "onTimeout": {
              "type": "string"
            }
          }
        }
      ]
    },
    "end": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type"
          ],
          "properties": {
            "type": {
              "const": "end"
            },
            "outputExpr": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
