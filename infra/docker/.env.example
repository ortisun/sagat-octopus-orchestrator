# Copy to infra/docker/.env and adjust. The real .env is git-ignored.
# These are DEVELOPMENT values; never reuse them anywhere that holds real data.

POSTGRES_USER=sagat
POSTGRES_PASSWORD=dev-only-change-me
# Password of the least-privilege role the API connects with (created on first start).
SAGAT_APP_PASSWORD=dev-only-app-change-me
POSTGRES_DB=sagat

# The OIDC provider the API and the engine trust. The default is the development provider of this
# stack (the `dev-idp` service: `sagat dev token` asks it for a token); it signs for anyone who asks, so
# it only runs with SAGAT_ENV=dev. For anything shared, point these at your own provider, set
# SAGAT_ALLOW_INSECURE_JWKS_HTTP=false and do not start dev-idp.
SAGAT_OIDC_ISSUER=http://dev-idp:9100/
SAGAT_OIDC_AUDIENCE=sagat-octopus-orchestrator
SAGAT_OIDC_JWKS_URI=http://dev-idp:9100/.well-known/jwks.json
SAGAT_OIDC_TENANT_CLAIM=tenant
SAGAT_ALLOW_INSECURE_JWKS_HTTP=true

# SAGAT_ENV gates development-only commands (the seed). The local stack defaults to dev; anything
# derived from this file for a shared environment must set it to staging or prod.
# SAGAT_ENV=dev

# Secret store (optional). A key ring is `id:base64`, comma separated, the first entry seals new
# values; make one key with `openssl rand -base64 32`. The control plane and the engine must get the
# same ring. Both listen in plaintext here, so outside SAGAT_ENV=dev set the two ALLOW variables to
# true only when TLS is terminated in front of them.
# SAGAT_SECRETS_KEYS=k1:<32 random bytes, base64>
# SAGAT_API_ALLOW_PLAINTEXT_SECRETS=false
# SAGAT_GRPC_ALLOW_PLAINTEXT_SECRETS=false

# Scripts (optional). The control plane serves the script routes only with a signing key:
#   docker run --rm sagat-octopus-orchestrator/control-plane:dev script-key
# SAGAT_SCRIPT_SIGNING_KEY=<base64 PKCS#8 Ed25519 key>
# The most any script may be given; the default has no network.
# SAGAT_SCRIPT_CEILING=v1;memory=268435456;cpu=1000;wall=30;pids=64;output=65536;scratch=33554432;egress=none
# The sandbox runner (`docker compose --profile sandbox up`) needs the group id of the engine's
# socket (`stat -c %g /var/run/docker.sock`), a token file and the namespaces it serves. The socket is
# root on the host that owns it: docs/runbooks/scripts.md.
# SAGAT_DOCKER_GID=            # unset: the runner cannot reach the engine, on purpose
# SAGAT_RUNNER_NAMESPACES=payments=<namespace id>
# SAGAT_RUNNER_TRUSTED_KEYS=<base64 public key of the control plane>

# Host ports (bound to 127.0.0.1). Defaults avoid 5432, 4222 and 8080. The Studio is at
# http://127.0.0.1:<SAGAT_API_PORT>/studio/ (sign in with the token `sagat dev token` prints).
# SAGAT_PG_PORT=15432
# SAGAT_NATS_PORT=14222
# SAGAT_NATS_MONITOR_PORT=18222
# SAGAT_API_PORT=18080
# SAGAT_GRPC_PORT=19000
# SAGAT_IDP_PORT=18090

# Internal notification transport: nats (default), redis, or none. Change all dispatchers together
# after stopping/joining the old ones; PostgreSQL remains authoritative. Workers keep using gRPC.
# SAGAT_EVENT_TRANSPORT=redis
# SAGAT_REDIS_PORT=16379
# SAGAT_REDIS_URL=redis://redis:6379/0
# SAGAT_REDIS_STREAM=sagat:v1:events
# SAGAT_REDIS_STREAM_MAXLEN=100000
# SAGAT_REDIS_TIMEOUT_SECS=5
# Enable Redis callback creation only after all old control planes and engines are upgraded.
# SAGAT_REDIS_CALLBACKS_ENABLED=false
