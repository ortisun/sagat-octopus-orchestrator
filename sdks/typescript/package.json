{
  "name": "@sagat-octopus-orchestrator/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Sagat Octopus Orchestrator: a client for runs and events, a worker host for activities, sagas and reconciliations, and typed builders of the workflow IR.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./opentelemetry": {
      "types": "./dist/src/opentelemetry.d.ts",
      "import": "./dist/src/opentelemetry.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "proto",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.js\"",
    "conformance": "node dist/conformance/runner.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.2",
    "@grpc/proto-loader": "^0.7.13"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": { "optional": true }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ortisun/sagat-octopus-orchestrator.git",
    "directory": "sdks/typescript"
  },
  "private": false
}
