{
  "name": "@sagat-octopus-orchestrator/workflows-bundler",
  "version": "0.2.0",
  "description": "Bundles TypeScript workflow code for the Sagat Octopus Orchestrator: one script with the SDK's determinism runtime, imports of built-in modules refused, and the manifest with each workflow type's code digest.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "sagat-workflows": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.8"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && TZ=UTC node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "@sagat-octopus-orchestrator/sdk": "0.2.0"
  },
  "devDependencies": {
    "@sagat-octopus-orchestrator/sdk": "file:../typescript",
    "@types/node": "^22.8.0",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ortisun/sagat-octopus-orchestrator.git",
    "directory": "sdks/typescript-workflows-bundler"
  },
  "private": false
}
