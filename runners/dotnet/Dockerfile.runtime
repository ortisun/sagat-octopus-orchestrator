FROM mcr.microsoft.com/dotnet/sdk:10.0.401@sha256:e70cdb7f80b0348f5cb85f19a8f670fca061f033d57eed12fa003d58b0e06317 AS publish
WORKDIR /src/runners/dotnet
COPY runners/dotnet/ ./
RUN dotnet restore Sagat.DotnetRuntime/Sagat.DotnetRuntime.csproj \
    && dotnet publish Sagat.DotnetRuntime/Sagat.DotnetRuntime.csproj --no-restore -c Release -o /out/runtime

FROM mcr.microsoft.com/dotnet/runtime:10.0.12@sha256:b89586dc17781f25531909993658aa8161205ae38b8cec8847df4a8221a403d5
WORKDIR /opt/sagat
COPY --from=publish /out/runtime/ ./runtime/
ENV DOTNET_EnableDiagnostics=0 \
    DOTNET_NOLOGO=1
USER 65534:65534
ENTRYPOINT ["dotnet", "/opt/sagat/runtime/Sagat.DotnetRuntime.dll"]
