{
  "name": "protocol-negotiation",
  "description": "A worker offers the newest protocol minor it speaks and runs at the newest both sides speak. Legacy protocol 1, the current 1.4 worker and a 1.5-capable worker are all served; production negotiates the 1.5 offer down to 1.4 and both minors execute the same root task. A different major or malformed version is a canonical UNSUPPORTED_PROTOCOL. The protocol 1 worker keeps a task alive past the 3 s lease with heartbeats that carry no step identity, and the task remains attempt 1.",
  "server": {"leaseTtlSeconds": 3},
  "workflows": {
    "slow": {"name": "protocol-flow", "program": [{"op": "step", "id": "slow", "activity": "protocol.slow"}]}
  },
  "workers": {
    "old": {"workerName": "protocol-old", "protocolVersion": "1", "maxInflight": 2, "autostart": false, "heartbeatIntervalMs": 200, "activities": {"protocol.slow": {"behavior": {"sleepMs": 4500, "returns": {"served": "at 1"}}}}},
    "current": {"workerName": "protocol-current", "protocolVersion": "1.4", "maxInflight": 2, "autostart": false, "heartbeatIntervalMs": 200, "activities": {"protocol.slow": {"behavior": {"returns": {"served": "at 1.4"}}}}},
    "new": {"workerName": "protocol-new", "protocolVersion": "1.5", "maxInflight": 2, "autostart": false, "heartbeatIntervalMs": 200, "activities": {"protocol.slow": {"behavior": {"returns": {"served": "at negotiated 1.4"}}}}}
  },
  "steps": [
    {"id": "offer-1", "op": "probeWorker", "protocolVersion": "1"},
    {"id": "offer-1.0", "op": "probeWorker", "protocolVersion": "1.0"},
    {"id": "offer-1.1", "op": "probeWorker", "protocolVersion": "1.1"},
    {"id": "offer-1.2", "op": "probeWorker", "protocolVersion": "1.2"},
    {"id": "offer-1.3", "op": "probeWorker", "protocolVersion": "1.3"},
    {"id": "offer-1.4", "op": "probeWorker", "protocolVersion": "1.4"},
    {"id": "offer-1.5", "op": "probeWorker", "protocolVersion": "1.5"},
    {"id": "offer-1.9", "op": "probeWorker", "protocolVersion": "1.9"},
    {"id": "offer-2", "op": "probeWorker", "protocolVersion": "2"},
    {"id": "offer-0.9", "op": "probeWorker", "protocolVersion": "0.9"},
    {"id": "offer-junk", "op": "probeWorker", "protocolVersion": "one"},
    {"id": "start-old", "op": "startWorker", "worker": "old"},
    {"id": "run-old", "op": "start", "workflow": "slow", "input": {"for": "old"}},
    {"id": "done-old", "op": "waitForCompletion", "run": "run-old", "timeoutMs": 30000},
    {"id": "stop-old", "op": "stopWorker", "worker": "old"},
    {"id": "start-current", "op": "startWorker", "worker": "current"},
    {"id": "run-current", "op": "start", "workflow": "slow", "input": {"for": "current"}},
    {"id": "done-current", "op": "waitForCompletion", "run": "run-current", "timeoutMs": 30000},
    {"id": "stop-current", "op": "stopWorker", "worker": "current"},
    {"id": "start-new", "op": "startWorker", "worker": "new"},
    {"id": "run-new", "op": "start", "workflow": "slow", "input": {"for": "new"}},
    {"id": "done-new", "op": "waitForCompletion", "run": "run-new", "timeoutMs": 30000}
  ]
}
