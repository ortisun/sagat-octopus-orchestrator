{
  "name": "state-operation-builders",
  "description": "Builder-only parity for additive v1 typed state and finite declared Query/Update definitions. No operation client call is enabled.",
  "buildOnly": true,
  "workflows": {
    "decimal-and-utc": {
      "name": "declared-account-state",
      "state": {
        "schema": {
          "type": "object",
          "properties": {
            "balance": {
              "type": "number",
              "minimum": 0
            },
            "status": {
              "type": "string",
              "maxLength": 16
            },
            "updatedAt": {
              "type": "string",
              "maxLength": 32
            }
          },
          "required": [
            "balance",
            "status",
            "updatedAt"
          ],
          "additionalProperties": false
        },
        "initial": "input.initialState",
        "queries": {
          "account.balance": {
            "argsSchema": {
              "type": "object",
              "properties": {
                "taxRate": {
                  "type": "number"
                }
              },
              "required": [
                "taxRate"
              ],
              "additionalProperties": false
            },
            "resultSchema": {
              "type": "number",
              "minimum": 0
            },
            "expression": "state.balance * 1.075 + args.taxRate",
            "disclosure": "declared-business-result-v1"
          },
          "account.cutoff": {
            "argsSchema": { "type": "object", "additionalProperties": false },
            "resultSchema": { "type": "string", "maxLength": 24 },
            "expression": "'2026-10-15T18:00:00.000Z'",
            "disclosure": "declared-business-result-v1"
          },
          "account.updated-at": {
            "argsSchema": {
              "type": "object",
              "additionalProperties": false
            },
            "resultSchema": {
              "type": "string",
              "maxLength": 32
            },
            "expression": "state.updatedAt",
            "disclosure": "declared-business-result-v1"
          }
        },
        "updates": {
          "account.replace": {
            "argsSchema": {
              "type": "object",
              "properties": {
                "nextState": {
                  "type": "object",
                  "properties": {
                    "balance": {
                      "type": "number",
                      "minimum": 0
                    },
                    "status": {
                      "type": "string",
                      "maxLength": 16
                    },
                    "updatedAt": {
                      "type": "string",
                      "maxLength": 32
                    }
                  },
                  "required": [
                    "balance",
                    "status",
                    "updatedAt"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "nextState"
              ],
              "additionalProperties": false
            },
            "validate": "args.nextState.balance >= 0",
            "state": "args.nextState",
            "result": "newState",
            "resultSchema": {
              "type": "object",
              "properties": {
                "balance": {
                  "type": "number",
                  "minimum": 0
                },
                "status": {
                  "type": "string",
                  "maxLength": 16
                },
                "updatedAt": {
                  "type": "string",
                  "maxLength": 32
                }
              },
              "required": [
                "balance",
                "status",
                "updatedAt"
              ],
              "additionalProperties": false
            },
            "disclosure": "declared-business-result-v1"
          }
        }
      },
      "program": [
        {
          "op": "end",
          "id": "waiting"
        }
      ]
    }
  },
