{
  "name": "secrets",
  "description": "US02/NFR-006-SEC: a step that declares a secret can read it through ctx.secrets() in every SDK, once the worker speaks protocol 1.2; the value never reaches a log, an error or the journal (the activity returns only its length, the next step sees that, and the run's events are read back). A worker that speaks protocol 1 has no ResolveSecrets: its secrets() raises the canonical UNSUPPORTED_PROTOCOL without calling the server (the activity reports that code as its output so it can be compared), and the run goes on.",
  "secrets": {
    "payments-key": "sk_test_secrets_conformance_value"
  },
  "mustNotLeak": [
    "sk_test_secrets_conformance_value"
  ],
  "workflows": {
    "reads": {
      "name": "secrets-flow",
      "program": [
        {
          "op": "step",
          "id": "read",
          "activity": "secrets.read",
          "options": {
            "secrets": [
              "payments-key"
            ]
          }
        },
        {
          "op": "step",
          "id": "after",
          "activity": "secrets.after"
        }
      ]
    },
    "readsOld": {
      "name": "secrets-old-flow",
      "program": [
        {
          "op": "step",
          "id": "read-old",
          "activity": "secrets.read-old",
          "options": {
            "secrets": [
              "payments-key"
            ]
          }
        },
        {
          "op": "step",
          "id": "after-old",
          "activity": "secrets.after"
        }
      ]
    }
  },
  "workers": {
    "w1": {
      "workerName": "secrets-worker",
      "protocolVersion": "1.4",
      "maxInflight": 2,
      "heartbeatIntervalMs": 200,
      "activities": {
        "secrets.read": {
          "behavior": {
            "readsSecret": "payments-key",
            "returns": {
              "used": true
            }
          }
        },
        "secrets.after": {
          "behavior": {
            "echo": true
          }
        }
      }
    },
    "old": {
      "workerName": "secrets-old-worker",
      "protocolVersion": "1",
      "maxInflight": 2,
      "autostart": false,
      "heartbeatIntervalMs": 200,
      "activities": {
        "secrets.read-old": {
          "behavior": {
            "readsSecret": "payments-key",
            "reportsSecretError": true,
            "returns": {
              "used": true
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "id": "read",
      "op": "start",
      "workflow": "reads",
      "input": {
        "case": "read"
      }
    },
    {
      "id": "read-done",
      "op": "waitForCompletion",
      "run": "read",
      "timeoutMs": 30000
    },
    {
      "id": "read-journal",
      "op": "events",
      "run": "read"
    },
    {
      "id": "start-old",
      "op": "startWorker",
      "worker": "old"
    },
    {
      "id": "read-old",
      "op": "start",
      "workflow": "readsOld",
      "input": {
        "case": "read-old"
      }
    },
    {
      "id": "read-old-done",
      "op": "waitForCompletion",
      "run": "read-old",
      "timeoutMs": 30000
    },
    {
      "id": "stop-old",
      "op": "stopWorker",
      "worker": "old"
    }
  ]
}
