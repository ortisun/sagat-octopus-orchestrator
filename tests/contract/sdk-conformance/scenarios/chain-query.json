{
  "name": "chain-query",
  "description": "The five SDKs query declared state through a publicly created chain and reject a mismatched expected head while the first activity remains pending.",
  "workflows": {
    "chain": {
      "name": "chain-query-runtime",
      "chainPolicy": { "maxSegments": 3, "timeoutMs": 86400000 },
      "state": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "amount": { "type": "string", "maxLength": 64 } },
          "required": ["amount"]
        },
        "initial": "input.account",
        "queries": {
          "amount.read": {
            "argsSchema": { "type": "object", "additionalProperties": false },
            "resultSchema": { "type": "string", "maxLength": 64 },
            "expression": "state.amount",
            "disclosure": "declared-business-result-v1"
          }
        },
        "updates": {}
      },
      "program": [
        { "op": "step", "id": "hold", "activity": "operations.unserved" },
        { "op": "continueAsNew", "id": "rollover", "input": "input", "state": "state" }
      ]
    }
  },
  "steps": [
    { "id": "start", "op": "start", "workflow": "chain", "input": { "account": { "amount": "19.99" } } },
    { "id": "query", "op": "queryChain", "namespaceId": "{{namespaceId}}", "chainId": "{{chainId:start}}", "expectedRunId": "{{chainId:start}}", "name": "amount.read", "args": {} },
    { "id": "other", "op": "start", "workflow": "chain", "input": { "account": { "amount": "7.00" } } },
    { "id": "stale", "op": "queryChain", "namespaceId": "{{namespaceId}}", "chainId": "{{chainId:start}}", "expectedRunId": "{{chainId:other}}", "name": "amount.read", "args": {} }
  ]
}
