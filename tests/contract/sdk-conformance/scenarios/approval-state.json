{
  "name": "approval-state",
  "description": "An approval and declared run state in one workflow (D295). While the request is open the state is read and updated (exact replay, stale revision as CONFLICT); the decision, a rejection, the expiry and a cancel each end the run with the state exactly as the last Update left it, readable but no longer mutable, and the request settled once.",
  "workflows": {
    "review": {
      "name": "approval-state-runtime",
      "state": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "amount": {
              "type": "string",
              "maxLength": 64
            }
          },
          "required": [
            "amount"
          ]
        },
        "initial": "input.account",
        "queries": {
          "amount.read": {
            "argsSchema": {
              "type": "object",
              "additionalProperties": false
            },
            "resultSchema": {
              "type": "string",
              "maxLength": 64
            },
            "expression": "state.amount",
            "disclosure": "declared-business-result-v1"
          }
        },
        "updates": {
          "amount.replace": {
            "argsSchema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "nextState": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "amount": {
                      "type": "string",
                      "maxLength": 64
                    }
                  },
                  "required": [
                    "amount"
                  ]
                }
              },
              "required": [
                "nextState"
              ]
            },
            "validate": "true",
            "state": "args.nextState",
            "result": "newState.amount",
            "resultSchema": {
              "type": "string",
              "maxLength": 64
            },
            "disclosure": "declared-business-result-v1"
          }
        }
      },
      "program": [
        {
          "op": "approval",
          "id": "review",
          "policy": {
            "roles": [
              "admin"
            ],
            "excludeInitiator": false
          },
          "timeoutMs": 86400000,
          "onApprove": "approved",
          "onReject": "rejected",
          "onExpire": "expired"
        },
        {
          "op": "end",
          "id": "approved",
          "options": {
            "outputExpr": "'approved'"
          }
        },
        {
          "op": "end",
          "id": "rejected",
          "options": {
            "outputExpr": "'rejected'"
          }
        },
        {
          "op": "end",
          "id": "expired",
          "options": {
            "outputExpr": "'expired'"
          }
        }
      ]
    },
    "short": {
