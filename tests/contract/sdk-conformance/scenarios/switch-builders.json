  "workers": {
    "w1": {
      "workerName": "switch-worker",
      "protocolVersion": "1.4",
      "maxInflight": 3,
      "heartbeatIntervalMs": 200,
      "activities": {
        "amount.positive": {
          "behavior": {
            "returns": {
              "route": "positive"
            }
          }
        },
        "amount.also-positive": {
          "behavior": {
            "returns": {
              "route": "also-positive"
            }
          }
        },
        "amount.fallback": {
          "behavior": {
            "returns": {
              "route": "fallback"
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "id": "first-match",
      "op": "start",
      "workflow": "ordered",
      "input": {
        "amount": 1
      }
    },
    {
      "id": "first-match-done",
      "op": "waitForCompletion",
      "run": "first-match",
      "timeoutMs": 30000
    },
    {
      "id": "first-match-journal",
      "op": "events",
      "run": "first-match"
    },
    {
      "id": "default",
      "op": "start",
      "workflow": "ordered",
      "input": {
        "amount": -1
      }
    },
    {
      "id": "default-done",
      "op": "waitForCompletion",
      "run": "default",
      "timeoutMs": 30000
    },
    {
      "id": "default-journal",
      "op": "events",
      "run": "default"
    },
    {
      "id": "predicate-error",
      "op": "start",
