{
  "name": "saga-compensation",
  "description": "US03: a saga whose last step fails for good is compensated in reverse order; every SDK receives the compensation as a COMPENSATION task that names the step it undoes and the key of the effect at the provider. A step whose outcome is unknown is reconciled, and the reconciler answers exactly a verdict. Neither `not_applied` nor `unknown` proves a final outcome: the run waits for an operator and nothing is retried blindly. The not-applied case continues only after an audited outcome-bearing resolution. The human resolution is a simulated assertion of final success; no provider verification is claimed.",
  "workflows": {
    "saga": {
      "name": "saga-flow",
      "program": [
        {
          "op": "saga",
          "id": "tx",
          "options": {
            "cancelPolicy": "compensate_completed"
          },
          "body": [
            {
              "op": "step",
              "id": "reserve",
              "activity": "saga.reserve",
              "options": {
                "compensateWith": "saga.release"
              }
            },
            {
              "op": "step",
              "id": "charge",
              "activity": "saga.charge",
              "options": {
                "compensateWith": "saga.refund"
              }
            },
            {
              "op": "step",
              "id": "ship",
              "activity": "saga.ship",
              "options": {
                "retry": {
                  "maxAttempts": 1
                }
              }
            }
          ]
        },
        {
          "op": "step",
          "id": "notify",
          "activity": "saga.notify"
        }
      ]
    },
    "reconcile": {
      "name": "reconcile-flow",
      "program": [
        {
          "op": "step",
          "id": "pay",
          "activity": "saga.pay",
          "options": {
            "reconcileWith": "saga.lookup",
            "retry": {
              "maxAttempts": 1
            }
          }
        },
        {
          "op": "step",
          "id": "receipt",
          "activity": "saga.receipt"
        }
      ]
    },
    "not-applied": {
      "name": "not-applied-flow",
      "program": [
        {
          "op": "step",
          "id": "pay2",
          "activity": "saga.pay2",
          "options": {
            "reconcileWith": "saga.lookup-none",
            "retry": {
              "maxAttempts": 3,
              "initialDelayMs": 50,
              "maxDelayMs": 50,
              "strategy": "fixed",
              "jitter": false
            }
          }
        }
      ]
    },
    "undecided": {
      "name": "undecided-flow",
      "program": [
        {
          "op": "step",
          "id": "pay3",
          "activity": "saga.pay3",
          "options": {
            "reconcileWith": "saga.lookup-unknown",
            "retry": {
              "maxAttempts": 1
            }
          }
        }
      ]
    }
  },
  "workers": {
    "w1": {
      "workerName": "saga-worker",
      "protocolVersion": "1.4",
      "maxInflight": 4,
      "heartbeatIntervalMs": 200,
      "activities": {
        "saga.reserve": {
          "behavior": {
            "returns": {
              "reservation": "r-1"
            }
          }
        },
        "saga.release": {
          "as": "compensation",
          "behavior": {
            "returns": {
              "released": true
            }
          }
        },
        "saga.charge": {
          "behavior": {
            "returns": {
              "charge": "c-1"
            }
          }
        },
        "saga.refund": {
          "as": "compensation",
          "behavior": {
            "returns": {
              "refunded": true
            }
          }
        },
        "saga.ship": {
          "behavior": {
            "fails": {
              "code": "NO_STOCK",
              "message": "nothing to ship",
              "retryable": false
            }
          }
        },
        "saga.notify": {
          "behavior": {
            "returns": {
              "notified": true
            }
          }
        },
        "saga.pay": {
          "behavior": {
            "outcomeUnknown": "the provider did not answer"
          }
        },
        "saga.lookup": {
          "as": "reconciler",
          "behavior": {
            "verdict": "applied",
            "output": {
              "paymentId": "p-9"
            }
          }
        },
        "saga.receipt": {
          "behavior": {
            "echo": true
          }
        },
        "saga.pay2": {
          "behavior": {
            "outcomeUnknown": "the provider did not answer the not-applied request"
          }
        },
        "saga.lookup-none": {
          "as": "reconciler",
          "behavior": {
            "verdict": "not_applied"
          }
        },
        "saga.pay3": {
          "behavior": {
            "outcomeUnknown": "the provider did not answer either"
          }
        },
        "saga.lookup-unknown": {
          "as": "reconciler",
          "behavior": {
            "verdict": "unknown"
          }
        }
      }
    }
  },
  "steps": [
    {
      "id": "saga",
      "op": "start",
      "workflow": "saga",
      "input": {
        "order": "o-1"
      }
    },
    {
      "id": "saga-done",
      "op": "waitForCompletion",
      "run": "saga",
      "timeoutMs": 30000
    },
    {
      "id": "saga-journal",
      "op": "events",
      "run": "saga"
    },
    {
      "id": "reconcile",
      "op": "start",
      "workflow": "reconcile",
      "input": {
        "order": "o-2"
      }
    },
    {
      "id": "reconcile-done",
      "op": "waitForCompletion",
      "run": "reconcile",
      "timeoutMs": 30000
    },
    {
      "id": "reconcile-journal",
      "op": "events",
      "run": "reconcile"
    },
    {
      "id": "not-applied",
      "op": "start",
      "workflow": "not-applied",
      "input": {
        "order": "o-na"
      }
    },
    {
      "id": "not-applied-concluded",
      "op": "awaitJournal",
      "run": "not-applied",
      "eventType": "reconciliation.concluded",
      "timeoutMs": 30000
    },
    {
      "id": "not-applied-state",
      "op": "get",
      "run": "not-applied"
    },
    {
      "id": "not-applied-resolved",
      "op": "operate",
      "run": "not-applied",
      "action": "RESOLVE_STEP",
      "stepId": "pay2",
      "outcome": "SUCCEEDED",
      "reason": "simulated human assertion of final success; no provider verification is claimed"
    },
    {
      "id": "not-applied-done",
      "op": "waitForCompletion",
      "run": "not-applied",
      "timeoutMs": 30000
    },
    {
      "id": "not-applied-journal",
      "op": "events",
      "run": "not-applied"
    },
    {
      "id": "undecided",
      "op": "start",
      "workflow": "undecided",
      "input": {
        "order": "o-un"
      }
    },
    {
      "id": "undecided-asked",
      "op": "awaitWorkerLog",
      "worker": "w1",
      "count": 12,
      "timeoutMs": 20000
    },
    {
      "id": "undecided-concluded",
      "op": "awaitJournal",
      "run": "undecided",
      "eventType": "reconciliation.concluded",
      "timeoutMs": 20000
    },
    {
      "id": "undecided-state",
      "op": "get",
      "run": "undecided"
    },
    {
      "id": "undecided-journal",
      "op": "events",
      "run": "undecided"
    }
  ],
  "reviewEvidence": true
}
