{
  "name": "lease-lost",
  "description": "A worker that loses its lease cancels its handler without reporting a known failure. The expired original activity remains under review at attempt one, and direct retry is refused. A simulated human assertion of final success releases a distinct successor to the second worker; it is not provider verification and never authorizes an automatic repeat of the unknown activity. The lease is explicitly aged by control.expireLease; the 120-second TTL protects unrelated work on a slow host.",
  "server": {
    "leaseTtlSeconds": 120
  },
  "workflows": {
    "work": {
      "name": "lease-flow",
      "program": [
        {
          "op": "step",
          "id": "work",
          "activity": "lease.work",
          "options": {
            "retry": {
              "maxAttempts": 3,
              "initialDelayMs": 600000,
              "maxDelayMs": 600000,
              "strategy": "fixed",
              "jitter": false
            }
          }
        },
        {
          "op": "step",
          "id": "after",
          "activity": "lease.after"
        }
      ]
    }
  },
  "workers": {
    "w1": {
      "workerName": "lease-w1",
      "protocolVersion": "1.4",
      "maxInflight": 1,
      "heartbeatIntervalMs": 150,
      "activities": {
        "lease.work": {
          "behavior": {
            "hang": true
          }
        }
      }
    },
    "w2": {
      "workerName": "lease-w2",
      "protocolVersion": "1.4",
      "maxInflight": 1,
      "autostart": false,
      "heartbeatIntervalMs": 60000,
      "activities": {
        "lease.work": {
          "behavior": {
            "returns": {
              "second": true
            }
          }
        },
        "lease.after": {
          "behavior": {
            "returns": {
              "continued": true
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "id": "start",
      "op": "start",
      "workflow": "work",
      "input": {
        "n": 1
      }
    },
    {
      "id": "leased",
      "op": "awaitJournal",
      "run": "start",
      "eventType": "step.started",
      "stepId": "work",
      "timeoutMs": 20000
    },
    {
      "id": "silent",
      "op": "control",
      "action": "expireLease",
      "run": "start",
      "node": "work"
    },
    {
      "id": "first-notices",
      "op": "awaitWorkerLog",
      "worker": "w1",
      "count": 1,
      "timeoutMs": 20000
    },
    {
      "id": "first-stops",
      "op": "stopWorker",
      "worker": "w1"
    },
    {
      "id": "second",
      "op": "startWorker",
      "worker": "w2"
    },
    {
      "id": "review-ready",
      "op": "awaitJournal",
      "run": "start",
      "eventType": "step.needs_review",
      "stepId": "work",
      "timeoutMs": 20000
    },
    {
      "id": "review-state",
      "op": "get",
      "run": "start"
    },
    {
      "id": "retry-refused",
      "op": "operate",
      "run": "start",
      "action": "RETRY_STEP",
      "stepId": "work",
      "reason": "an expired lease does not establish the original outcome"
    },
    {
      "id": "review-journal",
      "op": "events",
      "run": "start"
    },
    {
      "id": "human-resolution",
      "op": "operate",
      "run": "start",
      "action": "RESOLVE_STEP",
      "stepId": "work",
      "outcome": "SUCCEEDED",
      "reason": "simulated human assertion of final success; no provider verification is claimed"
    },
    {
      "id": "done",
      "op": "waitForCompletion",
      "run": "start",
      "timeoutMs": 30000
    },
    {
      "id": "journal",
      "op": "events",
      "run": "start"
    }
  ],
  "reviewEvidence": true
}
