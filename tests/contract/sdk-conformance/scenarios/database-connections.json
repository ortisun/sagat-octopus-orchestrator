  "workers": {
    "w1": {
      "workerName": "database-consumer",
      "protocolVersion": "1.4",
      "maxInflight": 1,
      "autostart": false,
      "activities": {
        "database.consume": {
          "behavior": {
            "echo": true
          }
        }
      }
    }
  },
  "steps": [
    {
      "id": "worker",
      "op": "startWorker",
      "worker": "w1"
    },
    {
      "id": "typed",
      "op": "start",
      "workflow": "typed",
      "input": {
        "orderId": "9007199254740993"
      }
    },
    {
      "id": "typed-done",
      "op": "waitForCompletion",
      "run": "typed",
      "timeoutMs": 30000
    },
    {
      "id": "write",
      "op": "start",
      "workflow": "write",
      "input": {}
