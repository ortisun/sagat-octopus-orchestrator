{
  "name": "approval-decisions",
  "status": "pending scheduler creation of native approval requests",
  "description": "The five SDKs call the public decision route with the same typed request and receipt. The runtime must expose the approval id created by the scheduler before this scenario can run without private seeding.",
  "workflows": {
    "review": {
      "name": "approval-decision-runtime",
      "program": [
        {
          "op": "approval",
          "id": "review",
          "policy": { "roles": ["admin"], "excludeInitiator": false },
          "timeoutMs": 86400000,
          "onApprove": "approved",
          "onReject": "rejected",
          "onExpire": "expired"
        },
        { "op": "end", "id": "approved", "options": { "outputExpr": "'approved'" } },
        { "op": "end", "id": "rejected", "options": { "outputExpr": "'rejected'" } },
        { "op": "end", "id": "expired", "options": { "outputExpr": "'expired'" } }
      ]
    }
  },
  "steps": [
    { "id": "start", "op": "start", "workflow": "review", "input": {}, "idempotencyKey": "approval-start-{{unique}}" },
    { "id": "unauthenticated", "op": "decideApproval", "token": "bad", "approvalId": "{{approvalId:start:review}}", "decisionKey": "decision-{{unique}}", "decision": "APPROVE", "reasonCode": "POLICY_OK" },
    { "id": "other-tenant", "op": "decideApproval", "token": "other", "approvalId": "{{approvalId:start:review}}", "decisionKey": "decision-{{unique}}", "decision": "APPROVE", "reasonCode": "POLICY_OK" },
    { "id": "approve", "op": "decideApproval", "approvalId": "{{approvalId:start:review}}", "decisionKey": "decision-{{unique}}", "decision": "APPROVE", "reasonCode": "POLICY_OK" },
    { "id": "replay", "op": "decideApproval", "approvalId": "{{approvalId:start:review}}", "decisionKey": "decision-{{unique}}", "decision": "APPROVE", "reasonCode": "POLICY_OK" },
    { "id": "key-conflict", "op": "decideApproval", "approvalId": "{{approvalId:start:review}}", "decisionKey": "decision-{{unique}}", "decision": "REJECT", "reasonCode": "POLICY_CHANGED" }
  ]
}
