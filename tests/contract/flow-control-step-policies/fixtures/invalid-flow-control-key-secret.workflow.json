{
  "apiVersion": "sagat-octopus-orchestrator.io/v1",
  "kind": "Workflow",
  "metadata": {"name": "secret-key"},
  "entrypoint": "call",
  "inputSchema": {
    "type": "object",
    "x-sagat-classification": "internal",
    "properties": {
      "accountId": {"type": "string"},
      "apiToken": {"type": "string", "x-sagat-classification": "secret"}
    }
  },
  "nodes": [
    {"id": "call", "type": "activity", "activity": "provider.call", "concurrency": {"key": "input.accountId + ':' + input.apiToken", "limit": 1}}
  ]
}
