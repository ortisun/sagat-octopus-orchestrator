{
  "_comment": "The wire of the lake sandbox API (ADR-0079, rules 3 to 5 and 14). Read by crates/infra-lake/tests/sandbox_api.rs; the server of apps/sandbox-runner reads the same file, so a client and a server that disagree fail one test. `body` is the exact text on the wire. An answer that is not recognised exactly is never read as started or ended.",
  "start_requests": [
    { "name": "a small attempt", "body": "{\"slot\":3,\"class\":\"small\",\"deadline_ms\":60000}", "expect": "ok" },
    { "name": "a large attempt", "body": "{\"slot\":4095,\"class\":\"large\",\"deadline_ms\":1}", "expect": "ok" },
    { "name": "members in another order", "body": "{\"deadline_ms\":5000,\"class\":\"small\",\"slot\":0}", "expect": "ok" },
    { "name": "a member nobody knows (an image)", "body": "{\"slot\":3,\"class\":\"small\",\"deadline_ms\":60000,\"image\":\"evil\"}", "expect": "rejected" },
    { "name": "a member nobody knows (a user)", "body": "{\"slot\":3,\"class\":\"small\",\"deadline_ms\":60000,\"user\":\"0\"}", "expect": "rejected" },
    { "name": "a member nobody knows (a mount)", "body": "{\"slot\":3,\"class\":\"small\",\"deadline_ms\":60000,\"mounts\":[\"/\"]}", "expect": "rejected" },
    { "name": "a limit as a member", "body": "{\"slot\":3,\"class\":\"small\",\"deadline_ms\":60000,\"memory_bytes\":1}", "expect": "rejected" },
    { "name": "no slot", "body": "{\"class\":\"small\",\"deadline_ms\":60000}", "expect": "rejected" },
    { "name": "no class", "body": "{\"slot\":3,\"deadline_ms\":60000}", "expect": "rejected" },
    { "name": "no deadline", "body": "{\"slot\":3,\"class\":\"small\"}", "expect": "rejected" },
    { "name": "a class that is not a name of the set", "body": "{\"slot\":3,\"class\":\"huge\",\"deadline_ms\":60000}", "expect": "rejected" },
    { "name": "a class in capitals", "body": "{\"slot\":3,\"class\":\"Small\",\"deadline_ms\":60000}", "expect": "rejected" },
    { "name": "a slot that is text", "body": "{\"slot\":\"3\",\"class\":\"small\",\"deadline_ms\":60000}", "expect": "rejected" },
    { "name": "a negative slot", "body": "{\"slot\":-1,\"class\":\"small\",\"deadline_ms\":60000}", "expect": "rejected" },
    { "name": "a fractional slot", "body": "{\"slot\":3.5,\"class\":\"small\",\"deadline_ms\":60000}", "expect": "rejected" },
    { "name": "a deadline that is text", "body": "{\"slot\":3,\"class\":\"small\",\"deadline_ms\":\"60000\"}", "expect": "rejected" },
    { "name": "a negative deadline", "body": "{\"slot\":3,\"class\":\"small\",\"deadline_ms\":-5}", "expect": "rejected" },
    { "name": "a slot past the last", "body": "{\"slot\":4096,\"class\":\"small\",\"deadline_ms\":60000}", "expect": "refused:slot" },
    { "name": "a slot far past the last", "body": "{\"slot\":4294967295,\"class\":\"small\",\"deadline_ms\":60000}", "expect": "refused:slot" },
    { "name": "a deadline of zero", "body": "{\"slot\":3,\"class\":\"small\",\"deadline_ms\":0}", "expect": "refused:deadline" },
    { "name": "a body that is not an object", "body": "[3,\"small\",60000]", "expect": "rejected" },
    { "name": "an empty body", "body": "", "expect": "rejected" },
    { "name": "text that is not JSON", "body": "slot=3", "expect": "rejected" },
    { "name": "a name twice", "body": "{\"slot\":3,\"slot\":4,\"class\":\"small\",\"deadline_ms\":60000}", "expect": "rejected" },
    { "name": "null", "body": "null", "expect": "rejected" }
  ],
  "start_answers": [
    { "name": "started", "status": 200, "body": "{\"result\":\"started\"}", "expect": "started" },
    { "name": "refused: ceiling", "status": 409, "body": "{\"result\":\"refused\",\"reason\":\"ceiling\"}", "expect": "refused:ceiling" },
    { "name": "refused: slot", "status": 409, "body": "{\"result\":\"refused\",\"reason\":\"slot\"}", "expect": "refused:slot" },
    { "name": "refused: class", "status": 409, "body": "{\"result\":\"refused\",\"reason\":\"class\"}", "expect": "refused:class" },
    { "name": "refused: deadline", "status": 409, "body": "{\"result\":\"refused\",\"reason\":\"deadline\"}", "expect": "refused:deadline" },
    { "name": "refused: directory", "status": 409, "body": "{\"result\":\"refused\",\"reason\":\"directory\"}", "expect": "refused:directory" },
    { "name": "unavailable", "status": 503, "body": "{\"result\":\"unavailable\"}", "expect": "unavailable" },
    { "name": "started with the wrong status", "status": 500, "body": "{\"result\":\"started\"}", "expect": "unavailable" },
    { "name": "started with a refusal's status", "status": 409, "body": "{\"result\":\"started\"}", "expect": "unavailable" },
    { "name": "refused with the status of success", "status": 200, "body": "{\"result\":\"refused\",\"reason\":\"ceiling\"}", "expect": "unavailable" },
    { "name": "a reason nobody knows", "status": 409, "body": "{\"result\":\"refused\",\"reason\":\"tired\"}", "expect": "unavailable" },
    { "name": "a refusal with no reason", "status": 409, "body": "{\"result\":\"refused\"}", "expect": "unavailable" },
    { "name": "a result nobody knows", "status": 200, "body": "{\"result\":\"started-twice\"}", "expect": "unavailable" },
    { "name": "started with a member added", "status": 200, "body": "{\"result\":\"started\",\"container\":\"abc\"}", "expect": "unavailable" },
    { "name": "a refusal with a member added", "status": 409, "body": "{\"result\":\"refused\",\"reason\":\"slot\",\"detail\":\"x\"}", "expect": "unavailable" },
    { "name": "the rejection of a request the client should not have made", "status": 400, "body": "{\"result\":\"rejected\"}", "expect": "unavailable" },
    { "name": "a body that is not JSON", "status": 200, "body": "started", "expect": "unavailable" },
    { "name": "an empty body", "status": 200, "body": "", "expect": "unavailable" },
    { "name": "a gateway's page", "status": 502, "body": "<html>bad gateway</html>", "expect": "unavailable" },
    { "name": "a body that is a string", "status": 200, "body": "\"started\"", "expect": "unavailable" },
    { "name": "a result that is not text", "status": 200, "body": "{\"result\":true}", "expect": "unavailable" },
    { "name": "a name twice with a refusal last", "status": 200, "body": "{\"result\":\"started\",\"result\":\"refused\"}", "expect": "unavailable" }
  ],
  "wait_answers": [
    { "name": "running", "status": 200, "body": "{\"state\":\"running\"}", "expect": "running" },
    { "name": "ended", "status": 200, "body": "{\"state\":\"ended\"}", "expect": "ended" },
    { "name": "unavailable", "status": 503, "body": "{\"result\":\"unavailable\"}", "expect": "unavailable" },
    { "name": "ended with the wrong status", "status": 202, "body": "{\"state\":\"ended\"}", "expect": "unavailable" },
    { "name": "ended with a server's error status", "status": 500, "body": "{\"state\":\"ended\"}", "expect": "unavailable" },
    { "name": "a state nobody knows", "status": 200, "body": "{\"state\":\"paused\"}", "expect": "unavailable" },
    { "name": "no state", "status": 200, "body": "{}", "expect": "unavailable" },
    { "name": "a state with a member added", "status": 200, "body": "{\"state\":\"ended\",\"memory_killed\":true}", "expect": "unavailable" },
    { "name": "a state in capitals", "status": 200, "body": "{\"state\":\"ENDED\"}", "expect": "unavailable" },
    { "name": "a state that is not text", "status": 200, "body": "{\"state\":1}", "expect": "unavailable" },
    { "name": "the answer of another call", "status": 200, "body": "{\"ended\":true,\"memory_killed\":false}", "expect": "unavailable" },
    { "name": "the answer of a start", "status": 200, "body": "{\"result\":\"started\"}", "expect": "unavailable" },
    { "name": "an empty body", "status": 200, "body": "", "expect": "unavailable" }
  ],
  "kill_answers": [
    { "name": "ended, killed by memory", "status": 200, "body": "{\"ended\":true,\"memory_killed\":true}", "expect": "ended:true,memory:true" },
    { "name": "ended, not by memory", "status": 200, "body": "{\"ended\":true,\"memory_killed\":false}", "expect": "ended:true,memory:false" },
    { "name": "not confirmed", "status": 200, "body": "{\"ended\":false,\"memory_killed\":false}", "expect": "ended:false,memory:false" },
    { "name": "not confirmed, but the flag was read", "status": 200, "body": "{\"ended\":false,\"memory_killed\":true}", "expect": "ended:false,memory:true" },
    { "name": "unavailable", "status": 503, "body": "{\"result\":\"unavailable\"}", "expect": "ended:false,memory:false" },
    { "name": "ended with the wrong status", "status": 204, "body": "{\"ended\":true,\"memory_killed\":false}", "expect": "ended:false,memory:false" },
    { "name": "ended with a server's error status", "status": 500, "body": "{\"ended\":true,\"memory_killed\":false}", "expect": "ended:false,memory:false" },
    { "name": "ended and no flag", "status": 200, "body": "{\"ended\":true}", "expect": "ended:false,memory:false" },
    { "name": "a flag and no ended", "status": 200, "body": "{\"memory_killed\":true}", "expect": "ended:false,memory:false" },
    { "name": "ended as text", "status": 200, "body": "{\"ended\":\"true\",\"memory_killed\":false}", "expect": "ended:false,memory:false" },
    { "name": "ended as a number", "status": 200, "body": "{\"ended\":1,\"memory_killed\":0}", "expect": "ended:false,memory:false" },
    { "name": "ended with a member added", "status": 200, "body": "{\"ended\":true,\"memory_killed\":false,\"container\":\"abc\"}", "expect": "ended:false,memory:false" },
    { "name": "the answer of a wait", "status": 200, "body": "{\"state\":\"ended\"}", "expect": "ended:false,memory:false" },
    { "name": "a body that is not JSON", "status": 200, "body": "ok", "expect": "ended:false,memory:false" },
    { "name": "an empty body", "status": 200, "body": "", "expect": "ended:false,memory:false" },
    { "name": "a name twice with the true one last", "status": 200, "body": "{\"ended\":false,\"memory_killed\":false,\"ended\":true}", "expect": "ended:false,memory:false" }
  ]
}
