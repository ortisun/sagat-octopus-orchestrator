{
  "apiVersion": "sagat-octopus-orchestrator.io/v1",
  "kind": "Workflow",
  "metadata": {
    "name": "lake-overwrite-filter"
  },
  "entrypoint": "extract",
  "nodes": [
    {
      "id": "extract",
      "type": "activity",
      "activity": "orders.extract",
      "next": "load"
    },
    {
      "id": "load",
      "type": "icebergWrite",
      "connectionRef": {
        "name": "lake-main",
        "revision": 3
      },
      "table": {
        "namespace": [
          "sales"
        ],
        "name": "orders"
      },
      "next": "done",
      "mode": "overwrite",
      "overwrite": {
        "scope": "filter",
        "filter": {
          "and": [
            {
              "compare": {
                "op": "ge",
                "column": "day",
                "value": "steps.extract.output.from"
              }
            },
            {
              "not": {
                "compare": {
                  "op": "isNull",
                  "column": "region"
                }
              }
            }
          ]
        }
      },
      "records": {
        "inline": "steps.extract.output.rows"
      }
    },
    {
      "id": "done",
      "type": "end"
    }
  ]
}
